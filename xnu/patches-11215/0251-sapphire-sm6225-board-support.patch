+/*
+ * sapphire: PM7250B (SID 2) SMB5 charger + QG fuel gauge (from ios-sapphire).
+ * Monotonic SOC from QG_SOC_MONOTONIC (0x48bf) or voltage curve,
+ * charger state from SMB5 (0x1006 / 0x1310).
+ */
+void
+SweetBattery::pollSapphire(void)
+{
+	const unsigned sid = 2;
+	uint8_t type = 0, present = 0, usb = 0, path = 0, charger = 0, error = 0, msoc = 0;
+	bool regs =
+	    !sweet_spmi_read(sid, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(sid, 0x4808, &present) &&
+	    !sweet_spmi_read(sid, 0x1310, &usb) &&
+	    !sweet_spmi_read(sid, 0x110b, &path) &&
+	    !sweet_spmi_read(sid, 0x1006, &charger) &&
+	    !sweet_spmi_read(sid, 0x1007, &error);
+
+	static const uint16_t vregs[] = { 0x48c0, 0x4880, 0x4890, 0x4870 };
+	uint16_t rawVoltage = 0;
+	unsigned which = 0, mv = 0;
+	for (; regs && which < 4; which++) {
+		if (readWord(vregs[which], &rawVoltage, sid) && rawVoltage != 0 && rawVoltage != 0x8000) {
+			mv = (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u);
+			if (mv >= 2800 && mv <= 4600) {
+				break;
+			}
+		}
+		mv = 0;
+	}
+	bool haveV = mv != 0;
+	(void)sweet_spmi_read(sid, 0x48bf, &msoc);
+	bool external = regs && (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 && !(error & 2u);
+	bool full = external && state == 5 && !(error & 2u);
+	unsigned percent = (msoc >= 1 && msoc <= 100) ? msoc : haveV ? estimatePercent(mv) : 50;
+	if (!regs) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	publish(full ? 100 : percent, haveV ? mv : 3900, 0, external, capable, charging, full, haveV, false);
+}
