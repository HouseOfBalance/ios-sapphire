 /* Poco F1: NT36672A, powered with the panel. Reset only if it does not answer. */
+static bool
+touch_sapphire_start(void)
+{
+	printf("SWEET TOUCH: sapphire TLMM rst%u=%#x/%#x irq%u=%#x/%#x sda=%#x scl=%#x\n",
+	    tb->rst, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    tb->irq, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->scl)));
+	touch_gpio(36, 0, 0, 0, true, true);
+	touch_gpio(tb->irq, 0, 3, 3, false, false);
+	touch_gpio(tb->sda, 0, 0, 0, false, false);
+	touch_gpio(tb->scl, 0, 0, 0, false, false);
+	touch_gpio(tb->rst, 0, 0, 0, true, true);
+	touch_wait(100);
+	st.bitbang = true;
+	st.probing = true;
+	uint8_t fid1 = 0, fid2 = 0;
+	int fe = touch_read(FT_ADDR, FT_ID_REG, false, &fid1, 1);
+	if (fe) {
+		printf("SWEET TOUCH: sapphire FT3519T silent (%d); pulsing reset\n", fe);
+		touch_gpio(tb->rst, 0, 0, 0, true, false);
+		touch_wait(15);
+		touch_gpio(tb->rst, 0, 0, 0, true, true);
+		touch_wait(200);
+		fe = touch_read(FT_ADDR, FT_ID_REG, false, &fid1, 1);
+	}
+	(void)touch_read(FT_ADDR, FT_ID2_REG, false, &fid2, 1);
+	st.probing = false;
+	printf("SWEET TOUCH: probe sapphire FT3519T at %#x: err=%d chip-id=%02x:%02x\n", FT_ADDR, fe, fid1, fid2);
+	st.kind = TOUCH_FT8719;
+	return true;
+}
