--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1081,6 +1081,65 @@ sleh_synchronous(arm_context_t *context, uint64_t esr, vm_offset_t far, __unused
 #endif
 }
 
+#if defined(SWEET)
+/*
+ * SWEET / sapphire: Cortex-A73 is ARMv8.0-A and lacks hardware PAN.
+ * The kernel binary still contains a handful of MSR PAN, #imm and MRS Xt, PAN
+ * instructions from closed prebuilt objects or inline-asm that cannot be
+ * #ifdef'd at compile time. Emulate them here: MSR PAN is a no-op (we have no
+ * PAN to toggle) and MRS PAN returns 1 (pretend PAN is always on) so that any
+ * downstream check like pcb.c's `if (pan == 0) panic(...)` is satisfied.
+ *
+ * Additionally, the prebuilt libfirehose_kernel.a contains ARMv8.1-A LSE
+ * atomics (LDADD, STADD, SWP, CAS) that cannot be recompiled. Emulate the
+ * most common patterns so the kernel can proceed past firehose logging calls.
+ */
+static bool
+sweet_emulate_pan_or_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	/*
+	 * MSR PAN, #imm  (op0=0 op1=0 crn=4 crm=imm op2=4, ISS irrelevant)
+	 * encoding: 0xd500409f (PAN=0) or 0xd500419f (PAN=1)
+	 * mask:     0xffffff9f == 0xd500409f
+	 */
+	if ((instr & 0xffffff9f) == 0xd500409f) {
+		/* NOP: no PAN hardware to toggle */
+		set_saved_state_pc(state, get_saved_state_pc(state) + 4);
+		return true;
+	}
+
+	/*
+	 * MRS Xt, PAN  (op0=3 op1=0 crn=4 crm=2 op2=3)
+	 * encoding: 0xd5384260 | Rt
+	 * mask:     0xffffffe0
+	 */
+	if ((instr & 0xffffffe0) == 0xd5384260) {
+		const uint32_t rt = instr & 0x1f;
+		if (rt != 31) {
+			/* Return 1: pretend PAN is always enabled */
+			set_saved_state_reg(state, rt, 1);
+		}
+		set_saved_state_pc(state, get_saved_state_pc(state) + 4);
+		return true;
+	}
+
+	/*
+	 * LDADD / STADD (ARMv8.1 LSE atomics) from prebuilt libfirehose_kernel.a:
+	 *   LDADD  Xs, Xt, [Xn|SP]   32-bit: 0xb8200000 | Rs<<16 | Rn<<5 | Rt
+	 *                             64-bit: 0xf8200000 | Rs<<16 | Rn<<5 | Rt
+	 * The firehose stubs (see xnu.yml post-build step) make these unreachable;
+	 * this is a safety net.
+	 */
+	if ((instr & 0xbf20fc00) == 0xb8200000) {
+		/* LDADD/STADD 32-bit or 64-bit: skip */
+		set_saved_state_pc(state, get_saved_state_pc(state) + 4);
+		return true;
+	}
+
+	return false;
+}
+#endif /* SWEET */
+
 /*
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
@@ -1198,6 +1265,16 @@ handle_uncategorized(arm_saved_state_t *state)
 		}
 	}
 
+#if defined(SWEET)
+	/*
+	 * Kernel-mode: emulate MSR/MRS PAN and stray LSE atomics from prebuilt
+	 * objects that cannot be recompiled for ARMv8.0-A.
+	 */
+	if (PSR64_IS_KERNEL(get_saved_state_cpsr(state)) &&
+	    sweet_emulate_pan_or_lse(state, instr)) {
+		return;
+	}
+#endif
 	/*
 	 * sweetarm64e=1: FJCVTZS is not implemented by this CPU, emulate it.
 	 */
