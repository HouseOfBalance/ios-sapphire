From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire Port <sapphire@xiaomi>
Date: Sun, 15 Nov 2026 18:11:00 +0700
Subject: [PATCH 0353] sapphire: fix GPU pool leak (10ms periodic reap + gemNew retry with exponential backoff)

---
diff --git a/iokit/Kernel/arm/SapphireGpu.cpp b/iokit/Kernel/arm/SapphireGpu.cpp
index 7121892..64b11c7 100644
--- a/iokit/Kernel/arm/SapphireGpu.cpp
+++ b/iokit/Kernel/arm/SapphireGpu.cpp
@@ -47,6 +47,8 @@
 #include <IOKit/IOPlatformExpert.h>               /* IOService::getPlatform() (the msm service) */
 #include <kern/thread.h>
 #include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <sys/sysctl.h>
 #include <pexpert/pexpert.h>
 #include <libkern/crc.h>
 #include <sys/param.h>
@@ -3490,6 +3492,13 @@ public:
 	struct msm_bo  *fLeft;                  /* MSM_LEFT of them: kept until their fence */
 	uint32_t        fCount, fSubmits, fQueue;
 	uint64_t        fBytes;
+	thread_call_t   fReapTimer;
+	bool            fReapTimerArmed;
+	uint32_t        fReapCount;
+	uint32_t        fReapTimerFirings;
+
+	static void reap_timer_trampoline(thread_call_param_t p0, thread_call_param_t p1);
+	void reapTimer(void);
 
 	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
 	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
@@ -3535,6 +3544,17 @@ SapphireGPUClient::initWithTask(task_t owningTask, void *securityID, UInt32 type
 	bzero(fLeft, sizeof(struct msm_bo) * MSM_LEFT);
 	fCount = fSubmits = fQueue = 0;
 	fBytes = 0;
+	fReapTimer = NULL;
+	fReapTimerArmed = false;
+	fReapCount = 0;
+	fReapTimerFirings = 0;
+	fReapTimer = thread_call_allocate(reap_timer_trampoline, (thread_call_param_t)this);
+	if (fReapTimer != NULL) {
+		fReapTimerArmed = true;
+		uint64_t dl = 0;
+		clock_interval_to_deadline(10, kMillisecondScale, &dl);
+		thread_call_enter_delayed(fReapTimer, dl);
+	}
 	LOG("msm: %s opened the GPU", fName);
 	return true;
 }
@@ -3640,19 +3660,79 @@ SapphireGPUClient::freeBo(struct msm_bo *b)
 	bzero(b, sizeof(*b));
 }
 
+static volatile uint32_t g_reap_total_count;
+static volatile uint32_t g_reap_timer_firings;
+
 /* Buffers given back earlier whose submissions are done now: freed. service_lock held. */
 void
 SapphireGPUClient::reap(void)
 {
 	for (uint32_t i = 0; fLeft != NULL && i < MSM_LEFT; i++) {
-		if (fLeft[i].md != NULL && msm_fence_done(fLeft[i].fence)) {
+		if (fLeft[i].md != NULL && (fLeft[i].fence == 0 || msm_fence_done(fLeft[i].fence))) {
 			fCount++;                       /* (counted out when it was left: release counts it again) */
 			fBytes += fLeft[i].size;
 			freeBo(&fLeft[i]);
+			fReapCount++;
+			OSIncrementAtomic((volatile SInt32 *)&g_reap_total_count);
 		}
 	}
 }
 
+void
+SapphireGPUClient::reapTimer(void)
+{
+	fReapTimerFirings++;
+	OSIncrementAtomic((volatile SInt32 *)&g_reap_timer_firings);
+	if (service_lock != NULL) {
+		IOLockLock(service_lock);
+		if (fReapTimerArmed && fLeft != NULL) {
+			reap();
+		}
+		IOLockUnlock(service_lock);
+	}
+	if (fReapTimerArmed && fReapTimer != NULL) {
+		uint64_t dl = 0;
+		clock_interval_to_deadline(10, kMillisecondScale, &dl);
+		thread_call_enter_delayed(fReapTimer, dl);
+	}
+}
+
+void
+SapphireGPUClient::reap_timer_trampoline(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	SapphireGPUClient *self = (SapphireGPUClient *)p0;
+	if (self != NULL) {
+		self->reapTimer();
+	}
+}
+
+static uint64_t
+gpool_free_pages_locked(void)
+{
+	uint64_t used = 0;
+	for (uint64_t w = 0; w < GPOOL_PAGES / 64; w++) {
+		used += (uint64_t)__builtin_popcountll(gpool_bits[w]);
+	}
+	return GPOOL_PAGES > used ? GPOOL_PAGES - used : 0;
+}
+
+static int
+sysctl_sweet_gpu_reap SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[192];
+	uint64_t free_pg = gpool_free_pages_locked();
+	int n = snprintf(buf, sizeof(buf), "reaped_total=%u,timer_firings=%u,pool_free_mb=%llu",
+	    g_reap_total_count, g_reap_timer_firings, (free_pg * 4) >> 10);
+	if (n < 0) {
+		return EIO;
+	}
+	return SYSCTL_OUT(req, buf, (size_t)n + 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_reap, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_gpu_reap, "A", "Sapphire GPU periodic reap and pool statistics");
+
 /*
  * GEM_CLOSE: the handle is free at once; the memory and the GPU addresses stay until the last
  * submission that named the buffer is done. service_lock held.
@@ -3684,6 +3764,12 @@ SapphireGPUClient::drop(struct msm_bo *b)
 IOReturn
 SapphireGPUClient::clientClose(void)
 {
+	fReapTimerArmed = false;
+	if (fReapTimer != NULL) {
+		thread_call_cancel(fReapTimer);
+		thread_call_free(fReapTimer);
+		fReapTimer = NULL;
+	}
 	if (service_ready && !msm_wait(msm_seq, 2000)) {       /* nothing of ours may still be at work */
 		msm_hung(fName, msm_seq, false);
 	}
@@ -3743,12 +3829,32 @@ SapphireGPUClient::gemNew(struct msm_gem_new *r)
 		return kIOReturnBadArgument;
 	}
 	if (gpool_enabled()) {
-		IOLockLock(service_lock);
-		uint64_t pa = gpool_alloc(size >> 12);
-		IOLockUnlock(service_lock);
+		uint32_t retries = 5, base_ms = 2;
+		(void)PE_parse_boot_argn("sweet_gpu_alloc_retry", &retries, sizeof(retries));
+		(void)PE_parse_boot_argn("sweet_gpu_alloc_sleep_ms", &base_ms, sizeof(base_ms));
+		if (retries < 1 || retries > 20) {
+			retries = 5;
+		}
+		if (base_ms < 1 || base_ms > 200) {
+			base_ms = 2;
+		}
+		uint64_t pa = 0;
+		for (uint32_t attempt = 0; attempt < retries; attempt++) {
+			IOLockLock(service_lock);
+			reap();
+			pa = gpool_alloc(size >> 12);
+			IOLockUnlock(service_lock);
+			if (pa != 0) {
+				break;
+			}
+			if (attempt + 1 < retries) {
+				uint32_t sleep_ms = base_ms << (attempt < 5 ? attempt : 5);
+				delay_for_interval(sleep_ms, NSEC_PER_MSEC);
+			}
+		}
 		if (pa == 0) {
-			LOG("msm: %s: the GPU pool has no %llu KB in one piece (%u buffers, %llu MB)", fName, size >> 10, fCount,
-			    fBytes >> 20);
+			LOG("msm: %s: the GPU pool has no %llu KB in one piece (%u buffers, %llu MB, pool free %llu MB)", fName,
+			    size >> 10, fCount, fBytes >> 20, (gpool_free_pages_locked() * 4) >> 10);
 			return kIOReturnNoMemory;
 		}
 		IOMemoryDescriptor *pm = IOMemoryDescriptor::withPhysicalAddress(pa, size, kIODirectionInOut);
