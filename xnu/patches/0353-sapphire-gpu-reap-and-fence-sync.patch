 	uint32_t        fCount, fSubmits, fQueue;
 	uint64_t        fBytes;
+	thread_call_t   fReapTimer;             /* periodic reap for stuck clients */
+	bool            fReapTimerArmed;
+	uint32_t        fReapCount;             /* total buffers reaped by timer */
+	uint32_t        fReapTimerFirings;      /* number of timer callbacks */
+	uint32_t        fReapInFlight;          /* buffers currently in fLeft awaiting fence */
+
+	static void reap_timer_trampoline(thread_call_param_t p0, thread_call_param_t p1);
+	void reapTimer();
+	void reap();                             /* forward declare for static helper */
+
+	/* sysctl handler */
+	static int sysctl_sweet_gpu_reap SYSCTL_HANDLER_ARGS;
+
 	struct msm_bo *slot(uint32_t *handle);
 	bool place(struct msm_bo *b);
 	void drop(struct msm_bo *b);
@@ -2985,6 +3001,30 @@ class SapphireGPUClient : public IOUserClient {

 extern "C" {

+/* Global GPU pool state for diagnostic dump (weak fallbacks if not exported) */
+extern uint64_t gpool_total_pages(void) __attribute__((weak));
+extern uint64_t gpool_free_pages(void) __attribute__((weak));
+extern uint64_t gpool_used_pages(void) __attribute__((weak));
+
+/* SMMU fault info for diagnostic dump */
+extern void smmu_dump_fault_info(void) __attribute__((weak));
+
+/* Global client list for force reap */
+extern void sapphire_gpu_force_reap_all_clients(void) __attribute__((weak));
+
+static inline uint64_t hk_gpool_total(void) { return gpool_total_pages ? gpool_total_pages() : 0; }
+static inline uint64_t hk_gpool_free(void)  { return gpool_free_pages  ? gpool_free_pages()  : 0; }
+static inline uint64_t hk_gpool_used(void)  { return gpool_used_pages  ? gpool_used_pages()  : 0; }
+static inline void hk_smmu_dump(void)       { if (smmu_dump_fault_info) smmu_dump_fault_info(); }
+static inline void hk_force_reap_all(void)  { if (sapphire_gpu_force_reap_all_clients) sapphire_gpu_force_reap_all_clients(); }
+
+/* Boot arg configuration for gpool_alloc_with_reap */
+static int sweet_gpu_alloc_retry = 5;      /* default 5 attempts */
+static int sweet_gpu_alloc_sleep_ms = 2;   /* default 2ms base sleep */
+
+/* Parse boot args early */
+static void parse_gpu_alloc_boot_args(void);
+
 /* Forward declarations for functions defined in this file */
 void sapphire_gpu_register_clients(void);
 void sapphire_gpu_unregister_clients(void);
@@ -3220,3 +3248,81 @@ SapphireGPUClient::initWithTask(task_t owningTask, void *securityID, UInt32 type
 	bzero(fLeft, sizeof(struct msm_bo) * MSM_LEFT);
 	fCount = fSubmits = fQueue = 0;
 	fBytes = 0;
+	fReapTimer = NULL;
+	fReapTimerArmed = false;
+	fReapCount = 0;
+	fReapTimerFirings = 0;
+	fReapInFlight = 0;
+	fReapTimer = thread_call_allocate(reap_timer_trampoline, (thread_call_param_t)this);
+	if (fReapTimer) {
+		fReapTimerArmed = true;
+		/* 10ms aggressive timer - matches frame interval (60-120 fps = 8-16ms) */
+		thread_call_enter_delayed(fReapTimer, 10 * NSEC_PER_MSEC);
+		LOG("msm: %s: reapTimer armed at 10ms", fName);
+	} else {
+		LOG("msm: %s: FAILED to allocate reapTimer", fName);
+	}
+
+	/*
+	 * The initial timer callback may fire before initWithTask returns; the client
+	 * lock is not held there, so reapTimer() must take service_lock itself.
+	 */
+	/* Register sysctl for this client's reap stats */
+	{
+		char sysctl_name[64];
+		snprintf(sysctl_name, sizeof(sysctl_name), "kern.sweet_gpu_reap.%s", fName);
+		sysctl_register_oid(&sysctl__kern_sweet_gpu_reap);
+	}
+	LOG("msm: %s opened the GPU", fName);
+	return true;
+}
