+/*
+ * Parse boot arguments for gpool_alloc_with_reap configuration.
+ * Called once at driver init.
+ */
+static void
+parse_gpu_alloc_boot_args(void)
+{
+	char buf[32];
+	int len = sizeof(buf);
+
+	if (PE_parse_boot_argn("sweet_gpu_alloc_retry", buf, &len)) {
+		int val = 0;
+		if (kstrtouint(buf, 0, &val) == 0 && val > 0 && val <= 20) {
+			sweet_gpu_alloc_retry = val;
+			LOG("msm: boot arg sweet_gpu_alloc_retry = %d", sweet_gpu_alloc_retry);
+		} else {
+			LOG("msm: invalid sweet_gpu_alloc_retry value '%s', using default %d", buf, sweet_gpu_alloc_retry);
+		}
+	}
+
+	len = sizeof(buf);
+	if (PE_parse_boot_argn("sweet_gpu_alloc_sleep_ms", buf, &len)) {
+		int val = 0;
+		if (kstrtouint(buf, 0, &val) == 0 && val > 0 && val <= 1000) {
+			sweet_gpu_alloc_sleep_ms = val;
+			LOG("msm: boot arg sweet_gpu_alloc_sleep_ms = %d", sweet_gpu_alloc_sleep_ms);
+		} else {
+			LOG("msm: invalid sweet_gpu_alloc_sleep_ms value '%s', using default %d", buf, sweet_gpu_alloc_sleep_ms);
+		}
+	}
+}
+
+void
+SapphireGPUClient::clientClose(void)
+{
+	if (fBo != NULL) {
+		for (uint32_t i = 0; i < MSM_BUFFERS; i++) {
+			if (fBo[i].md != NULL) {
+				/*
+				 * Buffers may still be in fLeft waiting for their fence.
+				 * Count them back in so freeBo's accounting stays consistent.
+				 */
+				if (fBo[i].fence != 0 && !msm_fence_done(fBo[i].fence)) {
+					fCount++;
+					fBytes += fBo[i].size;
+				}
+				freeBo(&fBo[i]);
+			}
+		}
@@ -3260,6 +3352,24 @@ SapphireGPUClient::clientClose(void)
 		IODelete(fBo, struct msm_bo, MSM_BUFFERS);
 		fBo = NULL;
 	}
+	if (fReapTimer) {
+		fReapTimerArmed = false;
+		thread_call_cancel(fReapTimer);
+		thread_call_free(fReapTimer);
+		fReapTimer = NULL;
+		LOG("msm: %s: reapTimer cancelled (firings=%u, reaped=%u, in_flight=%u)",
+		    fName, fReapTimerFirings, fReapCount, fReapInFlight);
+	}
+	if (fLeft != NULL) {
+		IODelete(fLeft, struct msm_bo, MSM_LEFT);
+		fLeft = NULL;
+	}
+	/* Unregister sysctl */
+	{
+		char sysctl_name[64];
+		snprintf(sysctl_name, sizeof(sysctl_name), "kern.sweet_gpu_reap.%s", fName);
+		sysctl_unregister_oid(&sysctl__kern_sweet_gpu_reap);
+	}
 	terminate();
 	return kIOReturnSuccess;
 }
@@ -3320,5 +3430,313 @@ SapphireGPUClient::reap(void)
 }

+void
+SapphireGPUClient::reapTimer()
+{
+	fReapTimerFirings++;
+
+	IOLockLock(service_lock);
+	uint32_t before_count = fCount;
+	uint64_t before_bytes = fBytes;
+
+	/* Count in-flight fLeft buffers before reap */
+	uint32_t in_flight_before = 0;
+	for (uint32_t i = 0; i < MSM_LEFT; i++) {
+		if (fLeft[i].md != NULL && fLeft[i].fence != 0 && !msm_fence_done(fLeft[i].fence)) {
+			in_flight_before++;
+		}
+	}
+	fReapInFlight = in_flight_before;
+
+	reap();
+
+	uint32_t after_count = fCount;
+	uint64_t after_bytes = fBytes;
+	uint32_t reaped_this_round = (before_count > after_count) ? (before_count - after_count) : 0;
+	fReapCount += reaped_this_round;
+	IOLockUnlock(service_lock);
+
+	/* Log EVERY firing with detailed status */
+	LOG("msm: %s: reapTimer#%u fCount=%u fLeft_inflight=%u fReapCount=%u fReapTimerFirings=%u reaped_this_round=%u (bytes %llu->%llu MB)",
+	    fName, fReapTimerFirings, fCount, fReapInFlight, fReapCount, fReapTimerFirings, reaped_this_round,
+	    before_bytes >> 20, after_bytes >> 20);
+
+	/* Re-arm for 10ms - do this unconditionally while armed, even if reap() took long */
+	if (fReapTimerArmed && fReapTimer) {
+		thread_call_enter_delayed(fReapTimer, 10 * NSEC_PER_MSEC);
+	}
+}
+
+void
+SapphireGPUClient::reap_timer_trampoline(thread_call_param_t p0, thread_call_param_t p1)
+{
+	SapphireGPUClient *self = (SapphireGPUClient *)p0;
+	self->reapTimer();
+}
+
+/*
+ * Reap completed fLeft buffers - called from reapTimer and gpool_alloc_with_reap
+ * Now with detailed logging of each fLeft slot's fence status.
+ * Returns number of buffers reaped.
+ */
+uint32_t
+SapphireGPUClient::reap(void)
+{
+	uint32_t reaped = 0;
+	uint64_t bytes_freed = 0;
+
+	LOG("msm: %s: reap() start - fCount=%u, fLeft[%u] slots:", fName, fCount, MSM_LEFT);
+
+	for (uint32_t i = 0; i < MSM_LEFT; i++) {
+		struct msm_bo *b = &fLeft[i];
+		if (b->md == NULL) {
+			continue; /* empty slot */
+		}
+
+		if (b->fence == 0) {
+			/* No fence - can free immediately */
+			LOG("msm: %s: reap: fLeft[%u] - NO FENCE (size=%llu KB), freeing", fName, i, b->size >> 10);
+			freeBo(b);
+			reaped++;
+			bytes_freed += b->size;
+			continue;
+		}
+
+		bool fence_done = msm_fence_done(b->fence);
+		if (fence_done) {
+			LOG("msm: %s: reap: fLeft[%u] - FENCE DONE (fence=%u, size=%llu KB), freeing", fName, i, b->fence, b->size >> 10);
+			freeBo(b);
+			reaped++;
+			bytes_freed += b->size;
+		} else {
+			LOG("msm: %s: reap: fLeft[%u] - FENCE PENDING (fence=%u, size=%llu KB), keeping", fName, i, b->fence, b->size >> 10);
+		}
+	}
+
+	if (reaped > 0) {
+		fCount -= reaped;
+		fBytes -= bytes_freed;
+		LOG("msm: %s: reap() done - reaped %u buffers, freed %llu KB, fCount now %u, fBytes now %llu MB",
+		    fName, reaped, bytes_freed >> 10, fCount, fBytes >> 20);
+	} else {
+		LOG("msm: %s: reap() done - no buffers reaped, fCount=%u, fBytes=%llu MB",
+		    fName, fCount, fBytes >> 20);
+	}
+	return reaped;
+}
+
+/*
+ * Dump full diagnostic state for a client (fLeft array, fences, etc.)
+ * Called when all retries fail.
+ */
+static void
+dump_client_diagnostic_state(SapphireGPUClient *client)
+{
+	LOG("msm: %s: === DIAGNOSTIC DUMP START ===", client->fName);
+	LOG("msm: %s: fCount=%u, fSubmits=%u, fQueue=%u, fBytes=%llu MB",
+	    client->fName, client->fCount, client->fSubmits, client->fQueue, client->fBytes >> 20);
+
+	/* Dump fLeft array */
+	for (uint32_t i = 0; i < MSM_LEFT; i++) {
+		struct msm_bo *b = &client->fLeft[i];
+		if (b->md == NULL) {
+			continue;
+		}
+		const char *fence_status = "NO_FENCE";
+		if (b->fence != 0) {
+			fence_status = msm_fence_done(b->fence) ? "DONE" : "PENDING";
+		}
+		LOG("msm: %s:   fLeft[%u]: md=%p size=%llu KB fence=%u (%s) gpuaddr=0x%llx",
+		    client->fName, i, b->md, b->size >> 10, b->fence, fence_status, b->gpuaddr);
+	}
+
+	/* Dump main buffer array */
+	for (uint32_t i = 0; i < MSM_BUFFERS; i++) {
+		struct msm_bo *b = &client->fBo[i];
+		if (b->md == NULL) {
+			continue;
+		}
+		const char *fence_status = "NO_FENCE";
+		if (b->fence != 0) {
+			fence_status = msm_fence_done(b->fence) ? "DONE" : "PENDING";
+		}
+		LOG("msm: %s:   fBo[%u]: md=%p size=%llu KB fence=%u (%s) gpuaddr=0x%llx handle=%u",
+		    client->fName, i, b->md, b->size >> 10, b->fence, fence_status, b->gpuaddr, b->handle);
+	}
+
+	LOG("msm: %s: === DIAGNOSTIC DUMP END ===", client->fName);
+}
+
+/*
+ * Dump global GPU pool state.
+ * Called when all retries fail.
+ */
+static void
+dump_global_pool_state(void)
+{
+	uint64_t total = hk_gpool_total();
+	uint64_t free = hk_gpool_free();
+	uint64_t used = hk_gpool_used();
+
+	LOG("msm: === GLOBAL GPU POOL STATE ===");
+	LOG("msm:   Total pages: %llu (%.1f MB)", total, total * 4.0 / 1024.0);
+	LOG("msm:   Free pages:  %llu (%.1f MB, %.1f%%)", free, free * 4.0 / 1024.0,
+	    total > 0 ? (free * 100.0 / total) : 0.0);
+	LOG("msm:   Used pages:  %llu (%.1f MB, %.1f%%)", used, used * 4.0 / 1024.0,
+	    total > 0 ? (used * 100.0 / total) : 0.0);
+	LOG("msm:   Free < 10%% threshold: %s", (free * 10 < total) ? "YES - FORCE REAP TRIGGERED" : "NO");
+}
+
+/*
+ * Attempt to free completed fLeft buffers, then retry the allocation.
+ * Called from gemNew() when gpool_alloc returns 0.
+ *
+ * Enhanced with:
+ * - Configurable retry count (sweet_gpu_alloc_retry, default 5)
+ * - Configurable base sleep (sweet_gpu_alloc_sleep_ms, default 2ms)
+ * - Exponential backoff: base * 2^attempt
+ * - Per-attempt logging with pool state, fLeft pending, fences signaled
+ * - Full diagnostic dump on failure
+ * - Force reap mode when pool < 10% free
+ */
+static bool
+gpool_alloc_with_reap(struct SapphireGPUClient *client, uint64_t n, uint64_t *out_pa)
+{
+	/* Parse boot args on first call */
+	static bool boot_args_parsed = false;
+	if (!boot_args_parsed) {
+		parse_gpu_alloc_boot_args();
+		boot_args_parsed = true;
+	}
+
+	int max_attempts = sweet_gpu_alloc_retry;
+	int base_sleep_ms = sweet_gpu_alloc_sleep_ms;
+
+	for (int attempt = 0; attempt < max_attempts; attempt++) {
+		/* Log pool state before attempt */
+		uint64_t pool_free_before = hk_gpool_free();
+		uint64_t pool_total = hk_gpool_total();
+		uint64_t pool_used = hk_gpool_used();
+
+		/* Count fLeft pending fences for this client */
+		uint32_t fleft_pending = 0;
+		uint32_t fleft_signaled = 0;
+		for (uint32_t i = 0; i < MSM_LEFT; i++) {
+			struct msm_bo *b = &client->fLeft[i];
+			if (b->md != NULL && b->fence != 0) {
+				if (msm_fence_done(b->fence)) {
+					fleft_signaled++;
+				} else {
+					fleft_pending++;
+				}
+			}
+		}
+
+		LOG("msm: %s: gpool_alloc_with_reap attempt %d/%d - need %llu pages (%.1f MB)",
+		    client->fName, attempt + 1, max_attempts, n, n * 4.0 / 1024.0);
+		LOG("msm: %s:   Pool state: total=%llu free=%llu used=%llu pages (%.1f/%.1f/%.1f MB)",
+		    client->fName, pool_total, pool_free_before, pool_used,
+		    pool_total * 4.0 / 1024.0, pool_free_before * 4.0 / 1024.0, pool_used * 4.0 / 1024.0);
+		LOG("msm: %s:   fLeft: pending=%u signaled=%u (of %u slots)",
+		    client->fName, fleft_pending, fleft_signaled, MSM_LEFT);
+
+		uint64_t pa = gpool_alloc(n);
+		if (pa != 0) {
+			*out_pa = pa;
+			if (attempt > 0) {
+				LOG("msm: %s: gpool_alloc_with_reap succeeded on attempt %d", client->fName, attempt + 1);
+			}
+			return true;
+		}
+
+		/* Pool exhausted: check if we should force reap ALL clients */
+		bool force_reap = (pool_free_before * 10 < pool_total); /* < 10% free */
+		if (force_reap) {
+			LOG("msm: %s: Pool critically low (<10%% free), triggering FORCE REAP of ALL clients",
+			    client->fName);
+			hk_force_reap_all();
+		}
+
+		/* Try to reap any completed fLeft buffers for this client */
+		LOG("msm: %s: gpool_alloc attempt %d failed, calling reap()%s",
+		    client->fName, attempt + 1, force_reap ? " (after force reap)" : "");
+		client->reap();
+
+		/* Log pool state after reap */
+		uint64_t pool_free_after = hk_gpool_free();
+		uint32_t fleft_pending_after = 0;
+		uint32_t fleft_signaled_after = 0;
+		for (uint32_t i = 0; i < MSM_LEFT; i++) {
+			struct msm_bo *b = &client->fLeft[i];
+			if (b->md != NULL && b->fence != 0) {
+				if (msm_fence_done(b->fence)) {
+					fleft_signaled_after++;
+				} else {
+					fleft_pending_after++;
+				}
+			}
+		}
+		LOG("msm: %s:   After reap: pool free=%llu pages (%.1f MB), fLeft pending=%u signaled=%u, fCount=%u",
+		    client->fName, pool_free_after, pool_free_after * 4.0 / 1024.0,
+		    fleft_pending_after, fleft_signaled_after, client->fCount);
+
+		if (attempt < max_attempts - 1) {
+			/* Exponential backoff: base * 2^attempt */
+			int sleep_ms = base_sleep_ms * (1 << attempt);
+			if (sleep_ms > 1000) sleep_ms = 1000; /* Cap at 1 second */
+
+			LOG("msm: %s:   Sleeping %dms before retry (exponential backoff: %dms * 2^%d)",
+			    client->fName, sleep_ms, base_sleep_ms, attempt);
+			thread_sleep_with_timeout(sleep_ms * NSEC_PER_MSEC, THREAD_UNINT);
+		}
+	}
+
+	/* All retries failed - dump full diagnostic state */
+	LOG("msm: %s: gpool_alloc_with_reap FAILED after %d attempts (need %llu KB)",
+	    client->fName, max_attempts, n * 4);
+
+	dump_global_pool_state();
+	dump_client_diagnostic_state(client);
+	hk_smmu_dump();
+
+	return false;
+}
+
+/*
+ * Sysctl handler for kern.sweet_gpu_reap
+ * Returns: inflight (buffers in fLeft awaiting fence), reaped_total, timer_firings
+ */
+static int
+sysctl_sweet_gpu_reap SYSCTL_HANDLER_ARGS
+{
+	SapphireGPUClient *client = (SapphireGPUClient *)arg1;
+	int error = 0;
+
+	/* We need to read stats under the lock */
+	IOLockLock(client->service_lock);
+	uint32_t inflight = 0;
+	for (uint32_t i = 0; i < MSM_LEFT; i++) {
+		if (client->fLeft[i].md != NULL && client->fLeft[i].fence != 0 && !msm_fence_done(client->fLeft[i].fence)) {
+			inflight++;
+		}
+	}
+	uint32_t reaped_total = client->fReapCount;
+	uint32_t timer_firings = client->fReapTimerFirings;
+	IOLockUnlock(client->service_lock);
+
+	/* Format as JSON-like string for easy parsing */
+	char buf[256];
+	snprintf(buf, sizeof(buf), "inflight=%u,reaped_total=%u,timer_firings=%u",
+	         inflight, reaped_total, timer_firings);
+
+	error = sysctl_handle_string(oidp, buf, strlen(buf), req);
+	return error;
+}
+
+SYSCTL_DECL(_kern);
+SYSCTL_NODE(_kern, OID_AUTO, sweet_gpu_reap, CTLFLAG_RD | CTLFLAG_MPSAFE, 0, "Sweet GPU reap statistics");
+
+/* Per-client sysctl oids will be registered dynamically in initWithTask */
+
 IOReturn
 SapphireGPUClient::gemNew(struct msm_gem_new *r)
 {
@@ -3380,9 +3732,10 @@ SapphireGPUClient::gemNew(struct msm_gem_new *r)
 	if (gpool_enabled()) {
 		IOLockLock(service_lock);
-		uint64_t pa = gpool_alloc(size >> 12);
+		uint64_t pa = 0;
+		bool ok = gpool_alloc_with_reap(this, size >> 12, &pa);
 		IOLockUnlock(service_lock);
-		if (pa == 0) {
+		if (!ok) {
 			LOG("msm: %s: the GPU pool has no %llu KB in one piece (%u buffers, %llu MB)", fName, size >> 10, fCount,
 			    fBytes >> 20);
 			return kIOReturnNoMemory;
 		}
