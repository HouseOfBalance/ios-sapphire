 shim/splash/make_splash.py             | 120 ++++++++++++++++++++++++---------------
 installer/update/steps.d/40-hakios-metal.sh |  10 ++-
 installer/update/steps.d/58-sapphire-hakios-metal-gmem.sh |  10 ++-
 android/dualboot/art/mkicon.py         |  30 ++++++---
 iokit/Kernel/arm/SweetFramebuffer.cpp  |  20 ++++--
 6 files changed, 120 insertions(+), 120 deletions(-)

