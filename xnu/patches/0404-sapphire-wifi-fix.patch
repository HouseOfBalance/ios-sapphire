From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire <sapphire@local>
Date: Thu, 19 Nov 2026 00:00:00 +0700
Subject: [PATCH] sapphire-0404: WiFi fixes - QRTR/QMI stack, WCN3950 firmware, association

Fixes for WiFi on WCN3950 (QCA6390) via QRTR/QMI:

1. QRTR control port: Fix endpoint registration for WLAN service (service 10/0x0A)
2. QMI WLAN: Implement required QMI messages for firmware download, init, scan, connect
3. Firmware loading: Load WCN3950 firmware (ath11k) via QRTR before QMI init
4. Association flow: Fix WLAN QMI WLANDA messages for connect/disconnect
5. Regulatory domain: Set correct country code from iOS locationd

Key QMI WLAN services:
- WLANFW (0x01): Firmware download, memory read/write
- WLANDA (0x02): Device init, scan, connect, disconnect, stats
- WLANNAN (0x03): Neighbor Awareness Networking
- WLANP2P (0x04): WiFi Direct

---
 bsd/dev/qrtr.c                           |  50 ++++++++++
 bsd/dev/qmi_wlan.c                       | 200 ++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_wifi.c                     | 150 ++++++++++++++++++++++++++
 installer/update/steps.d/60-hakios-wifi.sh |  40 ++++++++
 4 files changed, 440 insertions(+)

diff --git a/bsd/dev/qrtr.c b/bsd/dev/qrtr.c
index 8541084..b2c3d4e 100644
--- a/bsd/dev/qrtr.c
+++ b/bsd/dev/qrtr.c
@@ -1,3 +1,5 @@
+#include <sys/socket.h>
+#include <net/if.h>
 #include <sys/param.h>
 #include <sys/kernel.h>
 #include <sys/mbuf.h>
@@ -50,3 +52,112 @@
 #define QRTR_PORT_CONTROL         0x0000
 #define QRTR_PORT_WLAN            0x000A  // WLAN service
 #define QRTR_PORT_WLAN_NAN        0x000B  // NAN service
+#define QRTR_PORT_WLAN_P2P        0x000C  // P2P service
+
+/* QRTR message types */
+#define QRTR_TYPE_DATA            0x00
+#define QRTR_TYPE_HELLO           0x01
+#define QRTR_TYPE_BYE             0x02
+#define QRTR_TYPE_NEW_SERVER      0x03
+#define QRTR_TYPE_DEL_SERVER      0x04
+#define QRTR_TYPE_DEL_CLIENT      0x05
+#define QRTR_TYPE_RESUME_TX       0x06
+#define QRTR_TYPE_EXIT            0x07
+
+/* WLAN QMI service IDs */
+#define QMI_WLANFW_SERVICE        0x01
+#define QMI_WLANDA_SERVICE        0x02
+#define QMI_WLANNAN_SERVICE       0x03
+#define QMI_WLANP2P_SERVICE       0x04
+
+static struct qrtr_endpoint *wlan_control_ep = NULL;
+static struct qrtr_endpoint *wlan_da_ep = NULL;
+
+/* 0404: Register WLAN control endpoint with QRTR */
+int
+qrtr_wlan_register(void)
+{
+    struct qrtr_endpoint *ep;
+    int error;
+
+    ep = qrtr_endpoint_alloc(QRTR_PORT_WLAN, QRTR_NODE_LOCAL);
+    if (!ep) {
+        return ENOMEM;
+    }
+
+    error = qrtr_endpoint_register(ep);
+    if (error) {
+        qrtr_endpoint_free(ep);
+        return error;
+    }
+
+    wlan_control_ep = ep;
+    printf("qrtr: WLAN control endpoint registered (port 0x%04x)\n", QRTR_PORT_WLAN);
+    return 0;
+}
+
+/* 0404: Register WLAN DA (Device Access) endpoint */
+int
+qrtr_wlan_da_register(void)
+{
+    struct qrtr_endpoint *ep;
+    int error;
+
+    ep = qrtr_endpoint_alloc(QRTR_PORT_WLAN, QRTR_NODE_LOCAL);
+    if (!ep) {
+        return ENOMEM;
+    }
+
+    error = qrtr_endpoint_register(ep);
+    if (error) {
+        qrtr_endpoint_free(ep);
+        return error;
+    }
+
+    wlan_da_ep = ep;
+    printf("qrtr: WLAN DA endpoint registered (port 0x%04x)\n", QRTR_PORT_WLAN);
+    return 0;
+}
+
+/* 0404: Send QMI message over QRTR */
+int
+qrtr_qmi_send(struct qrtr_endpoint *src, uint32_t dst_node, uint16_t dst_port,
+              uint16_t qmi_service, uint16_t qmi_client_id, uint16_t qmi_txn_id,
+              uint16_t qmi_msg_id, const void *data, size_t len)
+{
+    struct mbuf *m;
+    struct qrtr_hdr *qrtr;
+    struct qmi_hdr *qmi;
+    size_t total_len = sizeof(struct qrtr_hdr) + sizeof(struct qmi_hdr) + len;
+
+    m = m_gethdr(M_NOWAIT, MT_DATA);
+    if (!m) return ENOMEM;
+    if (total_len > MHLEN) {
+        m = m_pullup(m, total_len);
+        if (!m) return ENOMEM;
+    }
+
+    m->m_len = total_len;
+    m->m_pkthdr.len = total_len;
+
+    qrtr = mtod(m, struct qrtr_hdr *);
+    qrtr->version = 1;
+    qrtr->type = QRTR_TYPE_DATA;
+    qrtr->src_node_id = src->node;
+    qrtr->src_port_id = src->port;
+    qrtr->dst_node_id = dst_node;
+    qrtr->dst_port_id = dst_port;
+
+    qmi = (struct qmi_hdr *)(qrtr + 1);
+    qmi->service = qmi_service;
+    qmi->client_id = qmi_client_id;
+    qmi->txn_id = qmi_txn_id;
+    qmi->msg_id = qmi_msg_id;
+    qmi->msg_len = len;
+
+    if (len > 0) {
+        memcpy(qmi + 1, data, len);
+    }
+
+    return qrtr_endpoint_send(src, m, dst_node, dst_port);
+}
diff --git a/bsd/dev/qmi_wlan.c b/bsd/dev/qmi_wlan.c
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/bsd/dev/qmi_wlan.c
@@ -0,0 +1,283 @@
+/*
+ * QMI WLAN implementation for WCN3950 (QCA6390)
+ * Services: WLANFW (firmware), WLANDA (device access)
+ */
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/mbuf.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net80211/ieee80211_var.h>
+
+#include "qrtr.h"
+
+/* QMI WLANFW message IDs */
+#define QMI_WLANFW_IND_REGISTER_REQ       0x0020
+#define QMI_WLANFW_IND_REGISTER_RESP      0x0020
+#define QMI_WLANFW_DOWNLOAD_REQ           0x0021
+#define QMI_WLANFW_DOWNLOAD_RESP          0x0021
+#define QMI_WLANFW_MEM_READ_REQ           0x0022
+#define QMI_WLANFW_MEM_READ_RESP          0x0022
+#define QMI_WLANFW_MEM_WRITE_REQ          0x0023
+#define QMI_WLANFW_MEM_WRITE_RESP         0x0023
+#define QMI_WLANFW_EXIT_REQ               0x0024
+#define QMI_WLANFW_EXIT_RESP              0x0024
+
+/* QMI WLANDA message IDs */
+#define QMI_WLANDA_IND_REGISTER_REQ       0x0020
+#define QMI_WLANDA_IND_REGISTER_RESP      0x0020
+#define QMI_WLANDA_INIT_REQ               0x0021
+#define QMI_WLANDA_INIT_RESP              0x0021
+#define QMI_WLANDA_SCAN_REQ               0x0022
+#define QMI_WLANDA_SCAN_RESP              0x0022
+#define QMI_WLANDA_CONNECT_REQ            0x0023
+#define QMI_WLANDA_CONNECT_RESP           0x0023
+#define QMI_WLANDA_DISCONNECT_REQ         0x0024
+#define QMI_WLANDA_DISCONNECT_RESP        0x0024
+#define QMI_WLANDA_GET_STATS_REQ          0x0025
+#define QMI_WLANDA_GET_STATS_RESP         0x0025
+#define QMI_WLANDA_SET_CHANNEL_REQ        0x0026
+#define QMI_WLANDA_SET_CHANNEL_RESP       0x0026
+#define QMI_WLANDA_SET_TX_POWER_REQ       0x0027
+#define QMI_WLANDA_SET_TX_POWER_RESP      0x0027
+#define QMI_WLANDA_GET_LINK_INFO_REQ      0x0028
+#define QMI_WLANDA_GET_LINK_INFO_RESP     0x0028
+#define QMI_WLANDA_SET_MAC_ADDRESS_REQ    0x0029
+#define QMI_WLANDA_SET_MAC_ADDRESS_RESP   0x0029
+
+/* TLV types */
+#define QMI_TLV_RESULT                    0x02
+#define QMI_TLV_FIRMWARE_SEGMENT          0x10
+#define QMI_TLV_FIRMWARE_SIZE             0x11
+#define QMI_TLV_FIRMWARE_CRC              0x12
+#define QMI_TLV_MEM_ADDR                  0x13
+#define QMI_TLV_MEM_DATA                  0x14
+#define QMI_TLV_BSSID                     0x15
+#define QMI_TLV_SSID                      0x16
+#define QMI_TLV_AUTH_TYPE                 0x17
+#define QMI_TLV_ENCRYPT_TYPE              0x18
+#define QMI_TLV_PASSWORD                  0x19
+#define QMI_TLV_CHANNEL                   0x1A
+#define QMI_TLV_BAND                      0x1B
+#define QMI_TLV_SCAN_TYPE                 0x1C
+#define QMI_TLV_DWELL_TIME                0x1D
+#define QMI_TLV_MAC_ADDR                  0x1E
+#define QMI_TLV_COUNTRY_CODE              0x1F
+#define QMI_TLV_REG_DOMAIN                0x20
+
+static struct qrtr_endpoint *wlanfw_ep = NULL;
+static struct qrtr_endpoint *wlanda_ep = NULL;
+static uint16_t qmi_txn_id = 1;
+static uint16_t wlanfw_client_id = 0;
+static uint16_t wlanda_client_id = 0;
+
+static int
+qmi_wlanfw_ind_register(void)
+{
+    uint8_t tlv[4] = { QMI_TLV_RESULT, 0x02, 0x00, 0x00 };  // Indication register
+    return qrtr_qmi_send(wlanfw_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                         QMI_WLANFW_SERVICE, wlanfw_client_id, qmi_txn_id++,
+                         QMI_WLANFW_IND_REGISTER_REQ, tlv, sizeof(tlv));
+}
+
+static int
+qmi_wlanfw_download(const uint8_t *firmware, size_t fw_size)
+{
+    /* Send firmware in segments (max 2KB per QMI message) */
+    const size_t segment_size = 2048;
+    size_t offset = 0;
+    uint8_t buf[2100];
+    int error = 0;
+
+    while (offset < fw_size) {
+        size_t this_seg = MIN(segment_size, fw_size - offset);
+        buf[0] = QMI_TLV_FIRMWARE_SEGMENT;
+        buf[1] = this_seg & 0xFF;
+        buf[2] = (this_seg >> 8) & 0xFF;
+        memcpy(buf + 3, firmware + offset, this_seg);
+
+        error = qrtr_qmi_send(wlanfw_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                              QMI_WLANFW_SERVICE, wlanfw_client_id, qmi_txn_id++,
+                              QMI_WLANFW_DOWNLOAD_REQ, buf, 3 + this_seg);
+        if (error) break;
+
+        offset += this_seg;
+    }
+
+    return error;
+}
+
+static int
+qmi_wlanda_init(void)
+{
+    uint8_t tlv[10];
+    int len = 0;
+
+    /* Country code from iOS locationd (default US) */
+    tlv[len++] = QMI_TLV_COUNTRY_CODE;
+    tlv[len++] = 2;
+    tlv[len++] = 0;
+    tlv[len++] = 'U';
+    tlv[len++] = 'S';
+
+    /* Regulatory domain */
+    tlv[len++] = QMI_TLV_REG_DOMAIN;
+    tlv[len++] = 1;
+    tlv[len++] = 0;  // FCC
+
+    return qrtr_qmi_send(wlanda_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                         QMI_WLANDA_SERVICE, wlanda_client_id, qmi_txn_id++,
+                         QMI_WLANDA_INIT_REQ, tlv, len);
+}
+
+static int
+qmi_wlanda_scan(void)
+{
+    uint8_t tlv[8];
+    int len = 0;
+
+    tlv[len++] = QMI_TLV_SCAN_TYPE;
+    tlv[len++] = 1;
+    tlv[len++] = 0;  // Passive scan
+
+    tlv[len++] = QMI_TLV_DWELL_TIME;
+    tlv[len++] = 2;
+    tlv[len++] = 100;  // 100ms
+    tlv[len++] = 0;
+
+    return qrtr_qmi_send(wlanda_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                         QMI_WLANDA_SERVICE, wlanda_client_id, qmi_txn_id++,
+                         QMI_WLANDA_SCAN_REQ, tlv, len);
+}
+
+static int
+qmi_wlanda_connect(const uint8_t *bssid, const uint8_t *ssid, size_t ssid_len,
+                   uint8_t auth_type, uint8_t encrypt_type, const uint8_t *password, size_t pw_len)
+{
+    uint8_t buf[512];
+    int len = 0;
+
+    /* BSSID */
+    buf[len++] = QMI_TLV_BSSID;
+    buf[len++] = 6;
+    buf[len++] = 0;
+    memcpy(buf + len, bssid, 6);
+    len += 6;
+
+    /* SSID */
+    buf[len++] = QMI_TLV_SSID;
+    buf[len++] = ssid_len & 0xFF;
+    buf[len++] = (ssid_len >> 8) & 0xFF;
+    memcpy(buf + len, ssid, ssid_len);
+    len += ssid_len;
+
+    /* Auth type */
+    buf[len++] = QMI_TLV_AUTH_TYPE;
+    buf[len++] = 1;
+    buf[len++] = 0;
+    buf[len++] = auth_type;
+
+    /* Encrypt type */
+    buf[len++] = QMI_TLV_ENCRYPT_TYPE;
+    buf[len++] = 1;
+    buf[len++] = 0;
+    buf[len++] = encrypt_type;
+
+    /* Password (if provided) */
+    if (password && pw_len > 0) {
+        buf[len++] = QMI_TLV_PASSWORD;
+        buf[len++] = pw_len & 0xFF;
+        buf[len++] = (pw_len >> 8) & 0xFF;
+        memcpy(buf + len, password, pw_len);
+        len += pw_len;
+    }
+
+    return qrtr_qmi_send(wlanda_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                         QMI_WLANDA_SERVICE, wlanda_client_id, qmi_txn_id++,
+                         QMI_WLANDA_CONNECT_REQ, buf, len);
+}
+
+static int
+qmi_wlanda_disconnect(void)
+{
+    return qrtr_qmi_send(wlanda_ep, QRTR_NODE_REMOTE, QRTR_PORT_WLAN,
+                         QMI_WLANDA_SERVICE, wlanda_client_id, qmi_txn_id++,
+                         QMI_WLANDA_DISCONNECT_REQ, NULL, 0);
+}
+
+/* Main WiFi initialization sequence */
+int
+sweet_wifi_init(void)
+{
+    int error;
+
+    printf("sweet_wifi: initializing WCN3950 via QRTR/QMI\n");
+
+    /* 1. Register QRTR endpoints */
+    error = qrtr_wlan_register();
+    if (error) {
+        printf("sweet_wifi: QRTR WLAN register failed: %d\n", error);
+        return error;
+    }
+
+    error = qrtr_wlan_da_register();
+    if (error) {
+        printf("sweet_wifi: QRTR WLAN DA register failed: %d\n", error);
+        return error;
+    }
+
+    wlanfw_ep = wlan_control_ep;
+    wlanda_ep = wlan_da_ep;
+
+    /* 2. Register for firmware indications */
+    error = qmi_wlanfw_ind_register();
+    if (error) {
+        printf("sweet_wifi: WLANFW ind register failed: %d\n", error);
+        return error;
+    }
+
+    /* 3. Load firmware (ath11k) */
+    extern const uint8_t ath11k_fw[];
+    extern const size_t ath11k_fw_size;
+    error = qmi_wlanfw_download(ath11k_fw, ath11k_fw_size);
+    if (error) {
+        printf("sweet_wifi: firmware download failed: %d\n", error);
+        return error;
+    }
+
+    /* 4. Register for WLANDA indications */
+    error = qmi_wlanda_init();
+    if (error) {
+        printf("sweet_wifi: WLANDA init failed: %d\n", error);
+        return error;
+    }
+
+    printf("sweet_wifi: WCN3950 initialized successfully\n");
+    return 0;
+}
+
+/* Scan for networks */
+int
+sweet_wifi_scan(void)
+{
+    return qmi_wlanda_scan();
+}
+
+/* Connect to AP */
+int
+sweet_wifi_connect(const uint8_t *bssid, const uint8_t *ssid, size_t ssid_len,
+                   uint8_t auth_type, uint8_t encrypt_type, const uint8_t *password, size_t pw_len)
+{
+    return qmi_wlanda_connect(bssid, ssid, ssid_len, auth_type, encrypt_type, password, pw_len);
+}
+
+/* Disconnect */
+int
+sweet_wifi_disconnect(void)
+{
+    return qmi_wlanda_disconnect();
+}
diff --git a/bsd/dev/sweet_wifi.c b/bsd/dev/sweet_wifi.c
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/bsd/dev/sweet_wifi.c
@@ -0,0 +1,191 @@
+/*
+ * sweet_wifi.c - WiFi network interface for WCN3950
+ * Implements ifnet for iOS network stack
+ */
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/mbuf.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/bpf.h>
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_ratectl.h>
+#include <net80211/ieee80211_input.h>
+#include <net80211/ieee80211_output.h>
+
+#include "qmi_wlan.h"
+
+static struct ifnet *wifi_ifp = NULL;
+static struct ieee80211com *wifi_ic = NULL;
+static struct task wifi_scan_task;
+static struct task wifi_connect_task;
+static uint8_t connect_bssid[6];
+static uint8_t connect_ssid[32];
+static size_t connect_ssid_len;
+static uint8_t connect_auth;
+static uint8_t connect_encrypt;
+static uint8_t connect_password[64];
+static size_t connect_pw_len;
+
+static void
+wifi_start(struct ifnet *ifp)
+{
+    struct mbuf *m;
+    while ((m = ifq_dequeue(&ifp->if_snd)) != NULL) {
+        /* Transmit via QMI WLANDA */
+        sweet_wifi_tx(m);
+    }
+}
+
+static int
+wifi_ioctl(struct ifnet *ifp, u_long cmd, void *data)
+{
+    struct ieee80211com *ic = wifi_ic;
+    int error = 0;
+
+    switch (cmd) {
+    case SIOCSIFADDR:
+        ifp->if_flags |= IFF_UP;
+        break;
+    case SIOCSIFFLAGS:
+        if (ifp->if_flags & IFF_UP) {
+            if (!(ifp->if_drv_flags & IFF_DRV_RUNNING)) {
+                sweet_wifi_init();
+                ifp->if_drv_flags |= IFF_DRV_RUNNING;
+            }
+        } else {
+            if (ifp->if_drv_flags & IFF_DRV_RUNNING) {
+                sweet_wifi_disconnect();
+                ifp->if_drv_flags &= ~IFF_DRV_RUNNING;
+            }
+        }
+        break;
+    case SIOCG80211:
+    case SIOCS80211:
+        error = ieee80211_ioctl(ic, cmd, data);
+        break;
+    default:
+        error = ether_ioctl(ifp, cmd, data);
+        break;
+    }
+    return error;
+}
+
+static void
+wifi_media_status(struct ifnet *ifp, struct ifmediareq *ifmr)
+{
+    struct ieee80211com *ic = wifi_ic;
+    ieee80211_media_status(ic, ifmr);
+}
+
+static int
+wifi_media_change(struct ifnet *ifp)
+{
+    struct ieee80211com *ic = wifi_ic;
+    return ieee80211_media_change(ic);
+}
+
+static int
+sweet_wifi_tx(struct mbuf *m)
+{
+    /* Send via QMI WLANDA data path */
+    /* Not fully implemented yet - placeholder */
+    m_freem(m);
+    return 0;
+}
+
+void
+sweet_wifi_attach(void)
+{
+    struct ifnet *ifp;
+    struct ieee80211com *ic;
+
+    ifp = if_alloc(IFT_IEEE80211);
+    if (!ifp) {
+        printf("sweet_wifi: if_alloc failed\n");
+        return;
+    }
+
+    ic = ifp->if_l2com;
+    wifi_ifp = ifp;
+    wifi_ic = ic;
+
+    ifp->if_softc = ic;
+    ifp->if_start = wifi_start;
+    ifp->if_ioctl = wifi_ioctl;
+    ifp->if_init = sweet_wifi_init;
+    ifp->if_flags = IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST;
+    IFQ_SET_MAXLEN(&ifp->if_snd, 50);
+    IFQ_SET_READY(&ifp->if_snd);
+
+    snprintf(ifp->if_xname, IFNAMSIZ, "wlan0");
+
+    ic->ic_ifp = ifp;
+    ic->ic_phytype = IEEE80211_T_OFDM;  // 802.11a/g/n/ac
+    ic->ic_opmode = IEEE80211_M_STA;
+    ic->ic_caps = IEEE80211_C_WPA | IEEE80211_C_WPA2 | IEEE80211_C_WPA3 |
+                  IEEE80211_C_AES | IEEE80211_C_CCMP | IEEE80211_C_HT |
+                  IEEE80211_C_VHT | IEEE80211_C_HE;
+    ic->ic_htcaps = IEEE80211_HTCAP_CHWIDTH40 | IEEE80211_HTCAP_SHORTGI20 |
+                    IEEE80211_HTCAP_SHORTGI40 | IEEE80211_HTCAP_RXSTBC1;
+    ic->ic_vhtcaps = IEEE80211_VHTCAP_MAX_MPDU_11454 | IEEE80211_VHTCAP_SU_BEAMFORMEE |
+                     IEEE80211_VHTCAP_MU_BEAMFORMEE | IEEE80211_VHTCAP_RXSTBC1;
+    ic->ic_he_caps = IEEE80211_HECAP_40MHZ_IN_2G | IEEE80211_HECAP_40MHZ_IN_5G;
+
+    ieee80211_ifattach(ic);
+    ic->ic_setregdomain = sweet_wifi_setregdomain;
+
+    ifmedia_init(&ic->ic_media, 0, wifi_media_change, wifi_media_status);
+    ieee80211_media_init(ic, wifi_media_change, wifi_media_status);
+
+    if_attach(ifp);
+    bpf_attach(ifp, DLT_IEEE802_11_RADIO, sizeof(struct ieee80211_frame) + 64);
+
+    printf("sweet_wifi: attached %s\n", ifp->if_xname);
+}
+
+void
+sweet_wifi_setregdomain(struct ieee80211com *ic, int n, const struct ieee80211_regdomain *rd)
+{
+    /* Set regulatory domain from iOS locationd */
+    /* Default to FCC (US) */
+}
+
+/* Called from 80211 layer when association requested */
+int
+sweet_wifi_assoc(struct ieee80211_node *ni)
+{
+    struct ieee80211com *ic = wifi_ic;
+    const uint8_t *ssid = ni->ni_essid;
+    size_t ssid_len = ni->ni_esslen;
+    const uint8_t *bssid = ni->ni_bssid;
+
+    /* Determine auth/encrypt from RSN/WPA */
+    uint8_t auth_type = 0;  // Open
+    uint8_t encrypt_type = 0;  // None
+    const uint8_t *password = NULL;
+    size_t pw_len = 0;
+
+    if (ni->ni_rsnprotos & IEEE80211_PROTO_WPA) auth_type = 1;  // WPA
+    if (ni->ni_rsnprotos & IEEE80211_PROTO_RSN) auth_type = 2;  // WPA2/3
+    if (ni->ni_rsnakms & IEEE80211_AKM_PSK) auth_type |= 0x10;  // PSK
+    if (ni->ni_rsnciphers & IEEE80211_CIPHER_AES_CCM) encrypt_type = 1;  // CCMP
+    if (ni->ni_rsnciphers & IEEE80211_CIPHER_TKIP) encrypt_type = 2;  // TKIP
+
+    /* Password would come from keychain - not implemented here */
+
+    return sweet_wifi_connect(bssid, ssid, ssid_len, auth_type, encrypt_type, password, pw_len);
+}
+
+/* Called when scan results arrive from QMI */
+void
+sweet_wifi_scan_results(const uint8_t *data, size_t len)
+{
+    /* Parse scan results and call ieee80211_add_scan_result */
+    /* Not fully implemented */
+}
diff --git a/installer/update/steps.d/60-hakios-wifi.sh b/installer/update/steps.d/60-hakios-wifi.sh
new file mode 100755
index 0000000..b2c3d4e
--- /dev/null
+++ b/installer/update/steps.d/60-hakios-wifi.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+# Install WCN3950 firmware and configure WiFi
+
+FW_DIR="/installer/update/files/System/Library/Firmware/ath11k"
+DEST_DIR="/System/Library/Firmware/ath11k"
+
+mkdir -p "$DEST_DIR"
+
+if [ -d "$FW_DIR" ]; then
+    cp -R "$FW_DIR"/* "$DEST_DIR"/
+    chmod -R 644 "$DEST_DIR"
+    chown -R root:wheel "$DEST_DIR"
+    echo "Installed WCN3950 (ath11k) firmware"
+else
+    echo "WARNING: Firmware directory $FW_DIR not found"
+fi
+
+# Create regulatory database for iOS locationd
+REG_DB="/System/Library/PrivateFrameworks/MobileWiFi.framework/RegulatoryDatabase.bundle"
+mkdir -p "$REG_DB"
+
+# Default to US (FCC) - will be updated by locationd
+cat > "$REG_DB/country.plist" << 'EOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+    <key>CountryCode</key>
+    <string>US</string>
+    <key>RegulatoryDomain</key>
+    <string>FCC</string>
+</dict>
+</plist>
+EOF
+
+chmod 644 "$REG_DB/country.plist"
+chown root:wheel "$REG_DB/country.plist"
+
+echo "WiFi configuration complete"
