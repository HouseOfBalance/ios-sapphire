From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire <sapphire@local>
Date: Sat, 14 Nov 2026 17:30:00 +0700
Subject: [PATCH] sapphire-0342: DisplayLink: cached sysctl, adaptive phase EMA, quality hysteresis

SapphireDisplayLink.m (userland) polls sysctl every frame: kern.sweet_fb_vsync_ts,
kern.sapphire_gpu_util. Each sysctlbyname() + malloc + parse = 50-100 µs.
At 120 Hz = 6-12 ms/s CPU burned. Also fixed 500 µs phase offset doesn't adapt.

Changes in kernel (this patch):
- Cached VSYNC timestamp: kernel exports latest vsync_ts via single sysctl read
- GPU util cached: updated from flip completion, not string-parsed
- sysctl kern.sapphire_dl_vsync exports struct with ts, gpu_util, frame_count
- Adaptive phase prediction: kernel provides EMA filter coefficients
- Quality reduction hysteresis: requires 5 consecutive misses/good frames

Userland (SapphireDisplayLink.m) changes in separate commit.
---
 bsd/kern/sweet_displaylink.c | 160 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 160 insertions(+)

diff --git a/bsd/kern/sweet_displaylink.c b/bsd/kern/sweet_displaylink.c
index 0000000..d4e5f6a 100644
--- /dev/null
+++ b/bsd/kern/sweet_displaylink.c
@@ -0,0 +1,160 @@
+/*
+ * sapphire-0342: DisplayLink VSYNC support for SapphireDisplayLink.m
+ * Cached VSYNC timestamp, GPU util, adaptive phase coefficients, quality hysteresis
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+#include <sys/sysctl.h>
+#include <sys/lock.h>
+#include <machine/machine_routines.h>
+
+/* Cached VSYNC data - updated from display interrupt/flip completion */
+static volatile uint64_t sweet_dl_last_vsync_ts = 0;      /* mach_absolute_time of last VSYNC */
+static volatile uint64_t sweet_dl_vsync_interval_ns = 8333333;  /* 120 Hz default */
+static volatile uint32_t sweet_dl_frame_count = 0;        /* incremented each VSYNC */
+static volatile uint32_t sweet_dl_gpu_util = 0;           /* permille (0-1000) */
+static volatile uint32_t sweet_dl_missed_frames = 0;      /* consecutive missed deadlines */
+static volatile uint32_t sweet_dl_good_frames = 0;        /* consecutive good frames */
+
+/* Adaptive phase prediction (EMA) */
+static int32_t sweet_dl_phase_ema_ns = 500000;  /* EMA of render time in ns, default 500 µs */
+static uint32_t sweet_dl_ema_alpha = 3;         /* EMA alpha = 3/10 = 0.3 */
+static uint32_t sweet_dl_ema_divisor = 10;
+
+/* Quality reduction hysteresis thresholds */
+static uint32_t sweet_dl_miss_threshold = 5;    /* 5 consecutive misses -> reduce quality */
+static uint32_t sweet_dl_good_threshold = 5;    /* 5 consecutive good -> restore quality */
+static uint32_t sweet_dl_quality_level = 100;   /* current quality % (100=full, 50=half-res) */
+
+/* Called from display interrupt/flip completion (kernel context) */
+void
+sweet_dl_vsync_notify(uint64_t vsync_ts, uint32_t gpu_util_pct)
+{
+    sweet_dl_last_vsync_ts = vsync_ts;
+    sweet_dl_frame_count++;
+    sweet_dl_gpu_util = gpu_util_pct;
+
+    /* Track consecutive misses/good for hysteresis */
+    if (gpu_util_pct > 950) {  /* >95% GPU util = likely missed frame */
+        sweet_dl_missed_frames++;
+        sweet_dl_good_frames = 0;
+    } else {
+        sweet_dl_good_frames++;
+        sweet_dl_missed_frames = 0;
+    }
+
+    /* Update EMA of render time (derive from GPU util) */
+    uint32_t frame_budget_ns = 8333333;
+    uint32_t estimated_render_ns = (frame_budget_ns * gpu_util_pct) / 1000;
+    sweet_dl_phase_ema_ns = (sweet_dl_phase_ema_ns * (sweet_dl_ema_divisor - sweet_dl_ema_alpha)
+                            + estimated_render_ns * sweet_dl_ema_alpha) / sweet_dl_ema_divisor;
+}
+
+/* Called when quality change requested from userland */
+uint32_t
+sweet_dl_get_quality_level(void)
+{
+    return sweet_dl_quality_level;
+}
+
+void
+sweet_dl_set_quality_level(uint32_t level)
+{
+    if (level > 100) level = 100;
+    if (level < 25) level = 25;
+    sweet_dl_quality_level = level;
+}
+
+/* 0342: Check and apply hysteresis - called from userland each frame */
+int
+sweet_dl_check_hysteresis(void)
+{
+    int action = 0;  /* 0=none, -1=reduce, +1=restore */
+
+    if (sweet_dl_missed_frames >= sweet_dl_miss_threshold && sweet_dl_quality_level > 25) {
+        sweet_dl_quality_level = (sweet_dl_quality_level * 3) / 4;  /* reduce by 25% */
+        if (sweet_dl_quality_level < 25) sweet_dl_quality_level = 25;
+        sweet_dl_missed_frames = 0;  /* reset after action */
+        action = -1;
+        printf("SWEET_DL: quality reduced to %u%% (misses=%u)\n",
+               sweet_dl_quality_level, sweet_dl_miss_threshold);
+    } else if (sweet_dl_good_frames >= sweet_dl_good_threshold && sweet_dl_quality_level < 100) {
+        sweet_dl_quality_level = (sweet_dl_quality_level * 5) / 4;  /* increase by 25% */
+        if (sweet_dl_quality_level > 100) sweet_dl_quality_level = 100;
+        sweet_dl_good_frames = 0;  /* reset after action */
+        action = 1;
+        printf("SWEET_DL: quality restored to %u%% (good=%u)\n",
+               sweet_dl_quality_level, sweet_dl_good_threshold);
+    }
+
+    return action;
+}
+
+/* 0342: Sysctl exporting cached VSYNC data for userland */
+static int
+sysctl_sweet_dl_vsync SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+    /* Pack all data into a single sysctl read - no string parsing needed */
+    struct {
+        uint64_t vsync_ts;
+        uint64_t interval_ns;
+        uint32_t frame_count;
+        uint32_t gpu_util;
+        uint32_t phase_ema_ns;
+        uint32_t quality_level;
+        uint32_t missed_frames;
+        uint32_t good_frames;
+    } data;
+
+    data.vsync_ts = sweet_dl_last_vsync_ts;
+    data.interval_ns = sweet_dl_vsync_interval_ns;
+    data.frame_count = sweet_dl_frame_count;
+    data.gpu_util = sweet_dl_gpu_util;
+    data.phase_ema_ns = (uint32_t)sweet_dl_phase_ema_ns;
+    data.quality_level = sweet_dl_quality_level;
+    data.missed_frames = sweet_dl_missed_frames;
+    data.good_frames = sweet_dl_good_frames;
+
+    return SYSCTL_OUT(req, &data, sizeof(data));
+}
+
+static int
+sysctl_sweet_dl_phase_ema SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+    int error = sysctl_handle_int(oidp, &sweet_dl_ema_alpha, 0, req);
+    return error;
+}
+
+static int
+sysctl_sweet_dl_hysteresis SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+    int error = sysctl_handle_int(oidp, &sweet_dl_miss_threshold, 0, req);
+    if (!error && req->newptr != USER_ADDR_NULL) {
+        /* Also update good threshold to match */
+        sweet_dl_good_threshold = sweet_dl_miss_threshold;
+    }
+    return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_dl_vsync, CTLTYPE_STRUCT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_dl_vsync, "SWEET_DL_VSYNC",
+    "Cached VSYNC data: ts, interval, frame_count, gpu_util, phase_ema, quality, misses, good");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_dl_phase_ema_alpha, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_dl_phase_ema, "I", "EMA alpha numerator (default 3, divisor 10 = 0.3)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_dl_hysteresis_threshold, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_dl_hysteresis, "I", "consecutive misses/good frames before quality change (default 5)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */