From: Sapphire <sapphire@local>
Date: Sat, 14 Nov 2026 18:00:00 +0700
Subject: [PATCH] sapphire-0346: DSI send DCS command from sysctl

Adds sweet_dsi_send_dcs() to AppleCLCD for kern.sweet_dsi_cmd sysctl.
This allows userspace (brightness bridge, thermald) to send arbitrary
DSI DCS commands to the panel.
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 50 +++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 8541084..f6a7b8c 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1183,5 +1183,71 @@ AppleCLCD::setPanelLevel(uint32_t level)
 }

+/* 0346: Send arbitrary DSI DCS command from sysctl */
+int
+sweet_dsi_send_dcs(const uint8_t *payload, uint32_t len)
+{
+    AppleCLCD *fb = sweet_dsi_fb;
+    if (!fb) {
+        return ENODEV;
+    }
+    if (len == 0 || len > 64) {
+        return EINVAL;
+    }
+
+    uint8_t cmd = payload[0];
+    uint32_t param_count = (len > 1) ? payload[1] : 0;
+    const uint8_t *params = (len > 2) ? &payload[2] : NULL;
+    uint32_t param_len = (param_count < len - 2) ? param_count : len - 2;
+
+    /* Validate param_count matches remaining bytes */
+    if (param_count != param_len) {
+        IOLog("SWEET DSI: param_count %u != remaining %u\n", param_count, param_len);
+        return EINVAL;
+    }
+
+    /* Use existing dsiSend infrastructure */
+    uint8_t hdr[4];
+    hdr[0] = cmd;
+    hdr[1] = 0;
+    hdr[2] = 0x05;  // DCS write long packet
+    hdr[3] = 0x80;  // HS mode
+
+    IOReturn ret = fb->dsiSend(hdr, params, param_len);
+    if (ret != kIOReturnSuccess) {
+        IOLog("SWEET DSI: dsiSend cmd 0x%02x failed: 0x%x\n", cmd, ret);
+        return EIO;
+    }
+
+    IOLog("SWEET DSI: cmd 0x%02x params=%u sent\n", cmd, param_count);
+    return 0;
+}
+
+/* 0346: Display power state for thermald deep sleep */
+void
+sweet_dsi_display_off(void)
+{
+    AppleCLCD *fb = sweet_dsi_fb;
+    if (!fb) return;
+    fb->setPanelOn(false);
+}
+
+void
+sweet_dsi_display_on(void)
+{
+    AppleCLCD *fb = sweet_dsi_fb;
+    if (!fb) return;
+    fb->setPanelOn(true);
+}
+
+/* 0346: Brightness level for brightness bridge */
+void
+sweet_dsi_set_brightness(uint32_t level)
+{
+    AppleCLCD *fb = sweet_dsi_fb;
+    if (!fb) return;
+    fb->setPanelLevel(level);
+}
+
 /* 0334: pipeline flip completion */
 void
 sweet_fb_flip_complete(void)
