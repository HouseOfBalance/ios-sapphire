From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire Port <sapphire@xiaomi>
Date: Sun, 15 Nov 2026 18:11:00 +0700
Subject: [PATCH 0351] sapphire: fix scale2 frame drop when GPU not ready

When sweetfb_scale=2 is set but GPU is not ready (gpu_frame=false),
the fScale2 block in AppleCLCD::present() currently does 'continue' which drops the frame
entirely, leaving the panel frozen.

Fix: When GPU copy fails or GPU is not ready, fall through to CPU copy path instead of dropping
the frame.

Signed-off-by: Sapphire Port <sapphire@xiaomi>
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1470,8 +1470,12 @@ AppleCLCD::present(const uint8_t *rec)
 			if (!shown && scale_told++ < 8) {
 				IOLog("SWEET FB: 2x frame not shown (layers %u, gpu %d, surface %ux%u bpe %u)\n", nlayers, gpu_frame,
 				    s->width, s->height, bpe);
 			}
-			s->release();
-			continue;
+			if (shown) {
+				s->release();
+				continue;
+			}
+			/* Fall through to CPU copy path below */
 		}
 		if (w <= 0 || h <= 0) {
 			w = (int32_t)s->width;
-- 
2.53.0
