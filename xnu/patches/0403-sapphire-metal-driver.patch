+/*
+ * HakiosMetalDevice implementation
+ */
+#include "HakiosMetalDevice.h"
+#include "HakiosCommandQueue.h"
+#include "HakiosTexture.h"
+#include "HakiosBuffer.h"
+#include "HakiosArgumentBuffer.h"
+#include "HakiosHeap.h"
+#include "HakiosLibrary.h"
+
+OSDefineMetaClassAndStructors(HakiosMetalDevice, IOService);
+
+bool
+HakiosMetalDevice::initWithAccelerator(IOService *accelerator)
+{
+    if (!IOService::init()) {
+        return false;
+    }
+    fAccelerator = accelerator;
+    if (fAccelerator) {
+        fAccelerator->retain();
+    }
+
+    // Get panel memory info from accelerator (AppleCLCD)
+    OSNumber *phys = OSDynamicCast(OSNumber, fAccelerator->getProperty("panel_phys"));
+    OSNumber *width = OSDynamicCast(OSNumber, fAccelerator->getProperty("panel_width"));
+    OSNumber *height = OSDynamicCast(OSNumber, fAccelerator->getProperty("panel_height"));
+    OSNumber *rowbytes = OSDynamicCast(OSNumber, fAccelerator->getProperty("panel_rowbytes"));
+
+    fPanelPhys = phys ? phys->unsigned64BitValue() : 0;
+    fPanelWidth = width ? width->unsigned32BitValue() : 1080;
+    fPanelHeight = height ? height->unsigned32BitValue() : 2400;
+    fPanelRowBytes = rowbytes ? rowbytes->unsigned32BitValue() : 4320;
+
+    return true;
+}
+
+void
+HakiosMetalDevice::free()
+{
+    OSSafeReleaseNULL(fAccelerator);
+    IOService::free();
+}
+
+MTLGPUFamily
+HakiosMetalDevice::gpuFamily() const
+{
+    return MTLGPUFamilyApple7;  // A11+ features, subset for A610
+}
+
+MTLReadWriteTextureTier
+HakiosMetalDevice::readWriteTextureSupport() const
+{
+    return MTLReadWriteTextureTierTier1;
+}
+
+MTLArgumentBuffersTier
+HakiosMetalDevice::argumentBuffersSupport() const
+{
+    return MTLArgumentBuffersTierTier1;
+}
+
+bool
+HakiosMetalDevice::supportsBCTextureCompression() const
+{
+    return false;  // Adreno 610: no BC
+}
+
+bool
+HakiosMetalDevice::supportsTextureCompressionASTC_HDR() const
+{
+    return false;  // Adreno 610: no ASTC HDR
+}
+
+bool
+HakiosMetalDevice::supportsRaytracing() const
+{
+    return false;
+}
+
+uint32_t
+HakiosMetalDevice::maxThreadgroupMemoryLength() const
+{
+    return 32768;  // 32 KB (Adreno 610)
+}
+
+uint32_t
+HakiosMetalDevice::maxBufferLength() const
+{
+    return 256 * 1024 * 1024;  // 256 MB
+}
+
+MTLSize
+HakiosMetalDevice::maxThreadsPerThreadgroup() const
+{
+    return MTLSizeMake(256, 1, 1);
+}
+
+id<MTLBuffer>
+HakiosMetalDevice::newBufferWithLength(NSUInteger length, MTLResourceOptions options)
+{
+    return [[HakiosBuffer alloc] initWithDevice:self length:length options:options];
+}
+
+id<MTLTexture>
+HakiosMetalDevice::newTextureWithDescriptor(const MTLTextureDescriptor *descriptor)
+{
+    return [[HakiosTexture alloc] initWithDevice:self descriptor:descriptor];
+}
+
+id<MTLTexture>
+HakiosMetalDevice::newTextureWithIOSurface(IOSurfaceRef surface, const MTLTextureDescriptor *descriptor, MTLResourceOptions options)
+{
+    return [[HakiosTexture alloc] initWithDevice:self surface:surface descriptor:descriptor options:options];
+}
+
+id<MTLHeap>
+HakiosMetalDevice::newHeapWithDescriptor(const MTLHeapDescriptor *descriptor)
+{
+    return [[HakiosHeap alloc] initWithDevice:self descriptor:descriptor];
+}
+
+id<MTLArgumentEncoder>
+HakiosMetalDevice::newArgumentEncoderWithArguments(const MTLArgumentDescriptor *arguments, NSUInteger count)
+{
+    return [[HakiosArgumentEncoder alloc] initWithDevice:self arguments:arguments count:count];
+}
+
+id<MTLBuffer>
+HakiosMetalDevice::newBufferWithBytes(const void *bytes, NSUInteger length, MTLResourceOptions options)
+{
+    id<MTLBuffer> buffer = [self newBufferWithLength:length options:options];
+    if (buffer && bytes) {
+        memcpy(buffer.contents, bytes, length);
+    }
+    return buffer;
+}
+
+id<MTLCommandQueue>
+HakiosMetalDevice::newCommandQueue()
+{
+    return [[HakiosCommandQueue alloc] initWithDevice:self];
+}
+
+id<MTLCommandQueue>
+HakiosMetalDevice::newCommandQueueWithMaxCommandBufferCount(NSUInteger maxCount)
+{
+    return [[HakiosCommandQueue alloc] initWithDevice:self maxCommandBufferCount:maxCount];
+}
+
+id<MTLLibrary>
+HakiosMetalDevice::newLibraryWithSource(const NSString *source, NSError **error)
+{
+    return [[HakiosLibrary alloc] initWithDevice:self source:source error:error];
+}
+
+id<MTLLibrary>
+HakiosMetalDevice::newLibraryWithFile(const NSString *filepath, NSError **error)
+{
+    return [[HakiosLibrary alloc] initWithDevice:self file:filepath error:error];
+}
+
+id<MTLFunction>
+HakiosMetalDevice::newFunctionWithName(const NSString *name)
+{
+    // Return a function from the default library
+    return nil; // Implemented in HakiosLibrary
+}
+
+id<MTLFence>
+HakiosMetalDevice::newFence()
+{
+    // Create a GPU fence
+    return nil;
+}
+
+id<MTLEvent>
+HakiosMetalDevice::newEvent()
+{
+    return nil;
+}
+
+id<MTLSharedEvent>
+HakiosMetalDevice::newSharedEvent()
+{
+    return nil;
+}
+
+void
+HakiosMetalDevice::purgeBuffer(id<MTLBuffer> buffer, NSUInteger offset, NSUInteger length)
+{
