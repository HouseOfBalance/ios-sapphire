+
+id
+HakiosArgumentEncoder::initWithDevice(id<MTLDevice> device, const MTLArgumentDescriptor *arguments, NSUInteger count)
+{
+    self = [super init];
+    if (self) {
+        _device = device;
+        _arguments = arguments;
+        _argumentCount = count;
+        _buffer = nil;
+        // Calculate required buffer size
+        _bufferSize = 0;
+        for (NSUInteger i = 0; i < count; i++) {
+            _bufferSize += arguments[i].size;
+        }
+        _bufferSize = (_bufferSize + 255) & ~255;  // 256-byte align
+    }
+    return self;
+}
+
+id<MTLBuffer>
+HakiosArgumentEncoder::argumentBuffer()
+{
+    if (!_buffer) {
+        _buffer = [_device newBufferWithLength:_bufferSize options:MTLResourceOptionCPUCacheModeDefault];
+    }
+    return _buffer;
+}
+
+void
+HakiosArgumentEncoder::setArgumentBuffer(id<MTLBuffer> buffer, NSUInteger offset)
+{
+    _buffer = buffer;
+    _bufferOffset = offset;
+}
+
+void
+HakiosArgumentEncoder::setTexture(id<MTLTexture> texture, NSUInteger index)
+{
+    if (index >= _argumentCount) return;
+    const MTLArgumentDescriptor *arg = &_arguments[index];
+    if (arg->type != MTLArgumentTypeTexture) return;
+
+    // Write texture descriptor into argument buffer
+    HakiosTexture *tex = (HakiosTexture *)texture;
+    uint64_t *dst = (uint64_t *)((uint8_t *)_buffer.contents + _bufferOffset + arg->offset);
+    *dst = tex->gpuDescriptorAddress();  // GPU virtual address of texture descriptor
+}
+
+void
+HakiosArgumentEncoder::setBuffer(id<MTLBuffer> buffer, NSUInteger offset, NSUInteger index)
+{
+    if (index >= _argumentCount) return;
+    const MTLArgumentDescriptor *arg = &_arguments[index];
+    if (arg->type != MTLArgumentTypeBuffer) return;
+
+    uint64_t *dst = (uint64_t *)((uint8_t *)_buffer.contents + _bufferOffset + arg->offset);
+    *dst = buffer.gpuAddress + offset;
+}
+
+void
+HakiosArgumentEncoder::setSamplerState(id<MTLSamplerState> sampler, NSUInteger index)
+{
+    if (index >= _argumentCount) return;
+    const MTLArgumentDescriptor *arg = &_arguments[index];
+    if (arg->type != MTLArgumentTypeSampler) return;
+
+    // Write sampler descriptor
+    uint64_t *dst = (uint64_t *)((uint8_t *)_buffer.contents + _bufferOffset + arg->offset);
+    *dst = sampler.gpuDescriptorAddress();
+}
+
+void
+HakiosArgumentEncoder::setBytes(const void *bytes, NSUInteger length, NSUInteger index)
+{
+    if (index >= _argumentCount) return;
+    const MTLArgumentDescriptor *arg = &_arguments[index];
+    if (arg->type != MTLArgumentTypeConstantData) return;
+
+    memcpy((uint8_t *)_buffer.contents + _bufferOffset + arg->offset, bytes, MIN(length, arg->size));
+}
+
+MTLSizeAndAlign
+HakiosArgumentEncoder::bufferSizeAndAlign()
+{
+    return MTLSizeAndAlignMake(_bufferSize, 256);
+}
