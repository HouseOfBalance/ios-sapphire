+/*
+ * HakiosMetalDevice - Metal driver for Adreno 610 (SM6225/sapphire)
+ * Implements MTLDevice protocol for iOS 16.7 (MSL 2.2)
+ */
+#ifndef _HAKIOS_METAL_DEVICE_H
+#define _HAKIOS_METAL_DEVICE_H
+
+#include <Metal/Metal.h>
+#include <IOKit/IOService.h>
+
+class HakiosMetalDevice : public IOService {
+    OSDeclareDefaultStructors(HakiosMetalDevice);
+
+public:
+    // MTLDevice properties
+    bool initWithAccelerator(IOService *accelerator);
+
+    // Feature queries (MSL 2.2)
+    virtual MTLGPUFamily gpuFamily() const;
+    virtual MTLReadWriteTextureTier readWriteTextureSupport() const;
+    virtual MTLArgumentBuffersTier argumentBuffersSupport() const;
+    virtual bool supportsBCTextureCompression() const;
+    virtual bool supportsTextureCompressionASTC_HDR() const;
+    virtual bool supportsRaytracing() const;
+    virtual uint32_t maxThreadgroupMemoryLength() const;
+    virtual uint32_t maxBufferLength() const;
+    virtual MTLSize maxThreadsPerThreadgroup() const;
+
+    // Resource creation
+    virtual id<MTLBuffer> newBufferWithLength(NSUInteger length, MTLResourceOptions options);
+    virtual id<MTLTexture> newTextureWithDescriptor(const MTLTextureDescriptor *descriptor);
+    virtual id<MTLTexture> newTextureWithIOSurface(IOSurfaceRef surface, const MTLTextureDescriptor *descriptor, MTLResourceOptions options);
+    virtual id<MTLHeap> newHeapWithDescriptor(const MTLHeapDescriptor *descriptor);
+
+    // Argument buffers (tier 1)
+    virtual id<MTLArgumentEncoder> newArgumentEncoderWithArguments(const MTLArgumentDescriptor *arguments, NSUInteger count);
+    virtual id<MTLBuffer> newBufferWithBytes(const void *bytes, NSUInteger length, MTLResourceOptions options);
+
+    // Command queue
+    virtual id<MTLCommandQueue> newCommandQueue();
+    virtual id<MTLCommandQueue> newCommandQueueWithMaxCommandBufferCount(NSUInteger maxCount);
+
+    // Library/Function
+    virtual id<MTLLibrary> newLibraryWithSource(const NSString *source, NSError **error);
+    virtual id<MTLLibrary> newLibraryWithFile(const NSString *filepath, NSError **error);
+    virtual id<MTLFunction> newFunctionWithName(const NSString *name);
+
+    // Synchronization
+    virtual id<MTLFence> newFence();
+    virtual id<MTLEvent> newEvent();
+    virtual id<MTLSharedEvent> newSharedEvent();
+
+    // Memory management
+    virtual void purgeBuffer(id<MTLBuffer> buffer, NSUInteger offset, NSUInteger length);
+
+    // For panel memory (framebuffer)
+    uint64_t panelPhysBase() const;
+    uint32_t panelWidth() const;
+    uint32_t panelHeight() const;
+    uint32_t panelRowBytes() const;
+
+private:
+    IOService *fAccelerator;
+    uint64_t fPanelPhys;
+    uint32_t fPanelWidth, fPanelHeight, fPanelRowBytes;
+};
+
+#endif /* _HAKIOS_METAL_DEVICE_H */
diff --git a/metal/HakiosMetalDevice.cpp b/metal/HakiosMetalDevice.cpp
