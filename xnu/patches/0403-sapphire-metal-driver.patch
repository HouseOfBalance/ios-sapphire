+id
+HakiosTexture::initWithDevice(id<MTLDevice> device, const MTLTextureDescriptor *descriptor)
+{
+    self = [super init];
+    if (self) {
+        _device = device;
+        _descriptor = descriptor;
+        _iosurface = nil;
+        // Allocate GPU memory via SapphireGpu
+    }
+    return self;
+}
+
+id
+HakiosTexture::initWithDevice(id<MTLDevice> device, IOSurfaceRef surface, const MTLTextureDescriptor *descriptor, MTLResourceOptions options)
+{
+    self = [super init];
+    if (self) {
+        _device = device;
+        _descriptor = descriptor;
+        _iosurface = surface;
+        IOSurfaceRetain(surface);
+        // Map IOSurface to GPU memory
+        HakiosMetalDevice *dev = (HakiosMetalDevice *)device;
+        uint64_t phys = IOSurfaceGetPhysicalAddress(surface, 0);
+        // Program texture descriptor in GPU
+    }
+    return self;
+}
+
+void
+HakiosTexture::free()
+{
+    if (_iosurface) {
+        IOSurfaceRelease(_iosurface);
+    }
+    [super free];
+}
