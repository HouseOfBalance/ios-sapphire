--- /dev/null
+++ b/installer/update/files/System/Library/Extensions/HakiosMetal.bundle/Contents/MacOS/HakiosMetal
@@ -0,0 +1,200 @@
+#!/bin/sh
+# HakiosMetal bundle executable - loads the Metal driver kext
+# This is a stub that ensures the kext is loaded
+
+KEXT="/System/Library/Extensions/HakiosMetal.kext"
+
+if [ ! -d "$KEXT" ]; then
+    echo "HakiosMetal.kext not found at $KEXT"
+    exit 1
+fi
+
+# Load the kext if not already loaded
+kextstat -b com.hakios.Metal >/dev/null 2>&1 || {
+    kextload "$KEXT"
+    if [ $? -ne 0 ]; then
+        echo "Failed to load HakiosMetal.kext"
+        exit 1
+    fi
+}
+
+exit 0
