+/*
+ * HakiosCommandBuffer - Metal command buffer for Adreno 610
+ * Implements blit/compute encoders for present path
+ */
+#include "HakiosCommandBuffer.h"
+#include "HakiosBlitEncoder.h"
+#include "HakiosComputeEncoder.h"
+#include "HakiosMetalDevice.h"
+#include "HakiosTexture.h"
+#include "HakiosBuffer.h"
+
+OSDefineMetaClassAndStructors(HakiosCommandBuffer, IOService);
+
+id
+HakiosCommandBuffer::initWithQueue(id<MTLCommandQueue> queue)
+{
+    self = [super init];
+    if (self) {
+        _queue = queue;
+        _device = queue.device;
+        _retainedReferences = YES;
+        _status = MTLCommandBufferStatusNotEnqueued;
+    }
+    return self;
+}
+
+id
+HakiosCommandBuffer::initWithQueue(id<MTLCommandQueue> queue, BOOL unretained)
+{
+    self = [super init];
+    if (self) {
+        _queue = queue;
+        _device = queue.device;
+        _retainedReferences = !unretained;
+        _status = MTLCommandBufferStatusNotEnqueued;
+    }
+    return self;
+}
+
+id<MTLBlitCommandEncoder>
+HakiosCommandBuffer::blitCommandEncoder()
+{
+    if (_encoderInUse) {
+        return nil;  // Only one encoder at a time
+    }
+    _encoderInUse = YES;
+    return [[HakiosBlitEncoder alloc] initWithCommandBuffer:self];
+}
+
+id<MTLComputeCommandEncoder>
+HakiosCommandBuffer::computeCommandEncoderWithDescriptor(const MTLComputePassDescriptor *descriptor)
+{
+    if (_encoderInUse) {
+        return nil;
+    }
+    _encoderInUse = YES;
+    return [[HakiosComputeEncoder alloc] initWithCommandBuffer:self descriptor:descriptor];
+}
+
+id<MTLRenderCommandEncoder>
+HakiosCommandBuffer::renderCommandEncoderWithDescriptor(const MTLRenderPassDescriptor *descriptor)
+{
+    if (_encoderInUse) {
+        return nil;
+    }
+    _encoderInUse = YES;
+    // Render encoder not implemented yet - use blit/compute
+    return nil;
+}
+
+void
+HakiosCommandBuffer::enqueue()
+{
+    _status = MTLCommandBufferStatusEnqueued;
+    // Submit to GPU via SapphireGpu
+}
+
+void
+HakiosCommandBuffer::commit()
+{
+    _status = MTLCommandBufferStatusCommitted;
+    // Flush to GPU
+    [self submitToGPU];
+}
+
+void
+HakiosCommandBuffer::waitUntilCompleted()
+{
+    // CPU wait for GPU completion (fence)
+    while (_status != MTLCommandBufferStatusCompleted) {
+        // Poll or wait on semaphore
+    }
+}
+
+void
+HakiosCommandBuffer::addCompletedHandler(void (^handler)(id<MTLCommandBuffer>))
+{
+    _completionHandler = [handler copy];
+}
+
+MTLCommandBufferStatus
+HakiosCommandBuffer::status() const
+{
+    return _status;
+}
+
+NSError *
