From: Sapphire Port <sapphire@xiaomi>
Subject: [PATCH] sapphire-0357: awdl0 interface bridged to en0 for AirDrop bring-up

Create awdl0 on APPLE80211_IOC_VIRTUAL_IF_CREATE (94) with IFEF_AWDL and full
Ethernet demux/framer callbacks, and bridge IPv6 multicast (mDNS _airdrop._tcp)
and awdl0 unicast frames between awdl0 and en0.
---
diff --git a/bsd/dev/sapphire_apple80211.c b/bsd/dev/sapphire_apple80211.c
index 9f25140..9b2c551 100644
--- a/bsd/dev/sapphire_apple80211.c
+++ b/bsd/dev/sapphire_apple80211.c
@@ -510,6 +510,177 @@ get(struct apple80211req *request)
 	return error;
 }
 
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <sys/kpi_mbuf.h>
+
+extern void sapphire_net_set_awdl_tap(void (*tap)(const uint8_t *frame, size_t length));
+extern void topaz_wlan_address(uint8_t address[6]);
+extern bool topaz_wlan_joined(void);
+extern bool topaz_wlan_transmit(const uint8_t *frame, size_t length);
+
+static ifnet_t awdl_ifp;
+static const uint8_t awdl_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static void
+awdl_rx_from_en0(const uint8_t *frame, size_t length)
+{
+	ifnet_t ifp = awdl_ifp;
+	if (ifp == NULL || length < 14 || length > 1514) {
+		return;
+	}
+	uint16_t etype = (uint16_t)((uint16_t)frame[12] << 8 | frame[13]);
+	bool is_mcast6 = (frame[0] == 0x33 && frame[1] == 0x33);
+	bool is_to_awdl = (memcmp(frame, awdl_mac, 6) == 0);
+	/* Forward IPv6 multicast (mDNS _airdrop._tcp.local, NDP) and frames addressed to awdl0 */
+	if (etype != 0x86DD || (!is_mcast6 && !is_to_awdl)) {
+		return;
+	}
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	if (mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		return;
+	}
+	char *header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -14);
+	mbuf_setdata(packet, header + 14, length - 14);
+	ifnet_input(ifp, packet, &stats);
+}
+
+static errno_t
+awdl_output(ifnet_t ifp, mbuf_t m)
+{
+	size_t len = mbuf_pkthdr_len(m);
+	if (len >= 14 && len <= 1514 && topaz_wlan_joined()) {
+		uint8_t buf[1514];
+		if (mbuf_copydata(m, 0, len, buf) == 0) {
+			/* Rewrite source MAC to en0's radio MAC so the AP forwards the frame */
+			topaz_wlan_address(buf + 6);
+			if (topaz_wlan_transmit(buf, len)) {
+				ifnet_stat_increment_out(ifp, 1, (uint32_t)len, 0);
+			}
+		}
+	}
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+awdl_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCAIFADDR:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		const int media[] = { IFM_IEEE80211 | IFM_AUTO };
+		struct ifmediareq *mr = data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)mr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)mr)->ifmu_ulist);
+		mr->ifm_active = mr->ifm_current = media[0];
+		mr->ifm_mask = 0;
+		mr->ifm_status = IFM_AVALID | IFM_ACTIVE;
+		mr->ifm_count = 1;
+		if (list != USER_ADDR_NULL) {
+			return copyout(media, list, sizeof(media));
+		}
+		return 0;
+	}
+	case SIOCGA80211:
+	case SIOCSA80211:
+		return sapphire_apple80211_ioctl(cmd, data);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static int
+awdl_create(void)
+{
+	if (awdl_ifp != NULL) {
+		return 0;
+	}
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "sapphire-awdl0",
+		.uniqueid_len = 14,
+		.name = "awdl",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = awdl_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = awdl_ioctl,
+		.broadcast_addr = bcast,
+		.broadcast_len = 6,
+	};
+	ifnet_t ifp = NULL;
+	errno_t err = ifnet_allocate_extended(&init, &ifp);
+	if (err != 0) {
+		printf("apple80211: awdl0 allocate failed: %d\n", err);
+		return err;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, 6);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, 1484);
+	ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING | IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_eflags(ifp, IFEF_AWDL, IFEF_AWDL);
+	ifnet_set_hdrlen(ifp, 14);
+	ifnet_set_offload(ifp, 0);
+	err = ifnet_attach(ifp, NULL);
+	if (err != 0) {
+		printf("apple80211: awdl0 attach failed: %d\n", err);
+		ifnet_release(ifp);
+		return err;
+	}
+	ifnet_set_lladdr(ifp, awdl_mac, 6);
+	awdl_ifp = ifp;
+	sapphire_net_set_awdl_tap(awdl_rx_from_en0);
+	printf("apple80211: awdl0 interface created and bridged to en0 (IFEF_AWDL)\n");
+	return 0;
+}
+
+static int
+awdl_delete(void)
+{
+	if (awdl_ifp == NULL) {
+		return 0;
+	}
+	sapphire_net_set_awdl_tap(NULL);
+	ifnet_detach(awdl_ifp);
+	ifnet_release(awdl_ifp);
+	awdl_ifp = NULL;
+	printf("apple80211: awdl0 interface deleted\n");
+	return 0;
+}
+
 /* ---- set ---------------------------------------------------------------------------------------------- */
 
 static int
@@ -647,6 +818,10 @@ set(const struct apple80211req *request, char *said, size_t said_size)
 	}
 	case 10:
 		return set_scan(request, said, said_size);
+	case 94:                                /* VIRTUAL_IF_CREATE: awdl0 bridged to en0 for sharingd/mDNSResponder */
+		return awdl_create();
+	case 95:                                /* VIRTUAL_IF_DELETE */
+		return awdl_delete();
 	default:
 		return EOPNOTSUPP;
 	}
diff --git a/bsd/dev/sapphire_net.c b/bsd/dev/sapphire_net.c
index 4a4496c..ceacccf 100644
--- a/bsd/dev/sapphire_net.c
+++ b/bsd/dev/sapphire_net.c
@@ -149,6 +149,14 @@ net_output(ifnet_t ifp, mbuf_t packet)
 	return 0;
 }
 
+static void (*awdl_rx_tap_fn)(const uint8_t *frame, size_t length);
+
+void
+sapphire_net_set_awdl_tap(void (*tap)(const uint8_t *frame, size_t length))
+{
+	awdl_rx_tap_fn = tap;
+}
+
 /* A frame has arrived. */
 void
 sapphire_net_input(const uint8_t *frame, size_t length)
@@ -159,6 +167,9 @@ sapphire_net_input(const uint8_t *frame, size_t length)
 	char *header;
 
 	trace_frame("in ", frame, length, length);
+	if (awdl_rx_tap_fn != NULL && length >= ETHER_HDR_LEN && length <= SAPPHIRE_NET_FRAME_MAX) {
+		awdl_rx_tap_fn(frame, length);
+	}
 	if (net_ifp == NULL || length < ETHER_HDR_LEN || length > SAPPHIRE_NET_FRAME_MAX ||
 	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
 		net_count.dropped_in++;
