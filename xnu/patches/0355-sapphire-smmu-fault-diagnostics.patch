From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire Port <sapphire@xiaomi>
Date: Sun, 15 Nov 2026 18:11:00 +0700
Subject: [PATCH 0355] sapphire: SMMU fault diagnostics and kern.sweet_smmu_fault sysctl

---
diff --git a/iokit/Kernel/arm/SapphireGpu.cpp b/iokit/Kernel/arm/SapphireGpu.cpp
index 64b11c7..0c468a6 100644
--- a/iokit/Kernel/arm/SapphireGpu.cpp
+++ b/iokit/Kernel/arm/SapphireGpu.cpp
@@ -1196,16 +1196,48 @@ smmu_identity(void)
 	return true;
 }
 
+static uint64_t last_smmu_far;
+static uint32_t last_smmu_fsr;
+static uint32_t last_smmu_gfsr;
+static uint32_t last_smmu_syndrome;
+static uint32_t smmu_fault_count;
+
 static void
 smmu_fault(const char *tag)
 {
 	if (smmu == NULL) {
 		return;
 	}
-	LOG("  [%s] SMMU gfsr %08x CB0 SCTLR %08x FSR %08x FAR %08x%08x FSYNR0 %08x", tag, rd(smmu, 0x48),
-	    rd(smmu, 0x8000), rd(smmu, 0x8058), rd(smmu, 0x8064), rd(smmu, 0x8060), rd(smmu, 0x8068));
+	uint32_t gfsr = rd(smmu, 0x48), sctlr = rd(smmu, 0x8000), fsr = rd(smmu, 0x8058);
+	uint64_t far = ((uint64_t)rd(smmu, 0x8064) << 32) | rd(smmu, 0x8060);
+	uint32_t fsynr0 = rd(smmu, 0x8068);
+	if (fsr != 0 || gfsr != 0) {
+		last_smmu_far = far;
+		last_smmu_fsr = fsr;
+		last_smmu_gfsr = gfsr;
+		last_smmu_syndrome = fsynr0;
+		smmu_fault_count++;
+	}
+	LOG("  [%s] SMMU gfsr %08x CB0 SCTLR %08x FSR %08x FAR %08x%08x FSYNR0 %08x", tag, gfsr,
+	    sctlr, fsr, (uint32_t)(far >> 32), (uint32_t)far, fsynr0);
+}
+
+static int
+sysctl_sweet_smmu_fault SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[192];
+	int n = snprintf(buf, sizeof(buf), "count=%u,far=0x%llx,fsr=0x%x,gfsr=0x%x,fsynr0=0x%x",
+	    smmu_fault_count, last_smmu_far, last_smmu_fsr, last_smmu_gfsr, last_smmu_syndrome);
+	if (n < 0) {
+		return EIO;
+	}
+	return SYSCTL_OUT(req, buf, (size_t)n + 1);
 }
 
+SYSCTL_PROC(_kern, OID_AUTO, sweet_smmu_fault, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_smmu_fault, "A", "Sapphire GPU SMMU fault diagnostics");
+
 /* ---------------------------------------------------------------- CP bring-up */
 
 /* The subset of Linux a6xx_gpu.c hw_init the command processor needs to run at all. */
