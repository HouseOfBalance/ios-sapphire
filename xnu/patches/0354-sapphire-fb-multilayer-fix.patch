From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sapphire Port <sapphire@xiaomi>
Date: Sun, 15 Nov 2026 18:11:00 +0700
Subject: [PATCH 0354] sapphire: fix multi-layer frame drop in scale2 path by falling through to CPU copy

---
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 03654e2..76242aa 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1727,12 +1727,15 @@ AppleCLCD::present(const uint8_t *rec)
 					gpu_used = true;
 				}
 			}
-			if (!shown && scale_told++ < 8) {
-				IOLog("SWEET FB: 2x frame not shown (layers %u, gpu %d, surface %ux%u bpe %u)\n", nlayers, gpu_frame,
+			if (shown) {
+				s->release();
+				continue;
+			}
+			if (scale_told++ < 8) {
+				IOLog("SWEET FB: 2x frame CPU fallback (layers %u, gpu %d, surface %ux%u bpe %u)\n", nlayers, gpu_frame,
 				    s->width, s->height, bpe);
 			}
-			s->release();
-			continue;
+			/* Fall through to CPU copy path below so multi-layer or pre-GPU frames are not dropped */
 		}
 		if (w <= 0 || h <= 0) {
 			w = (int32_t)s->width;
