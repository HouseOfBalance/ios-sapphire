 }

+/*
+ * 0406: GPU context switch - save current, restore new
+ * Called when submitting work for a different process
+ */
+IOReturn
+SapphireGpu::gpuContextSwitch(task_t task)
+{
+    if (!fVmEnabled || !fVmLock) {
+        return kIOReturnSuccess;  // VM not enabled
+    }
+
+    IOLockLock(fVmLock);
+
+    /* Find or create VM context for task */
+    struct sweet_gpu_vm_context *ctx = sweet_gpu_vm_context_find(task);
+    if (!ctx) {
+        ctx = sweet_gpu_vm_context_create(task);
+    }
+
+    int new_asid = sweet_gpu_vm_get_asid(ctx);
+    uint64_t new_ttbr = sweet_gpu_vm_get_ttbr(ctx);
+
+    if (new_asid != fCurrentAsid || new_ttbr != fCurrentTtbr) {
+        /* Wait for GPU idle */
+        while (grd(REG_CP_RB_RPTR) != grd(REG_CP_RB_WPTR)) {
+            IOSleep(1);
+        }
+
+        /* Save old context (ASID/TTBR saved in context struct) */
+
+        /* Switch MMU context */
+        gwr(REG_MMU_CB_ASID, new_asid);
+        gwr(REG_MMU_CB_TTBR0, new_ttbr);
+        gwr(REG_MMU_CB_TTBR1, new_ttbr);  // Same for now
+        gmb();
+
+        fCurrentAsid = new_asid;
+        fCurrentTtbr = new_ttbr;
+
+        LOG("gpu: context switch to ASID %d, TTBR 0x%llx", new_asid, new_ttbr);
+    }
+
+    IOLockUnlock(fVmLock);
+    return kIOReturnSuccess;
+}
+
+/*
+ * 0406: Map buffer for GPU access
+ * Called from user client when creating buffer objects
+ */
+IOReturn
+SapphireGpu::gpuMapBuffer(IOMemoryDescriptor *buffer, uint64_t *gpu_va_out, uint32_t *size_out)
+{
+    if (!fVmEnabled) {
+        /* Fallback: use physical address directly (low DDR pool) */
+        *gpu_va_out = buffer->getPhysicalAddress();
+        *size_out = buffer->getLength();
+        return kIOReturnSuccess;
+    }
+
+    task_t task = current_task();
+    struct sweet_gpu_vm_context *ctx = sweet_gpu_vm_context_find(task);
+    if (!ctx) {
+        ctx = sweet_gpu_vm_context_create(task);
+    }
+
+    /* Get physical pages from buffer */
+    uint32_t page_count = (buffer->getLength() + SWEET_GPU_PAGE_SIZE - 1) / SWEET_GPU_PAGE_SIZE;
+    vm_offset_t *phys_pages = (vm_offset_t *)IOMalloc(page_count * sizeof(vm_offset_t));
+
+    buffer->getPhysicalSegments(phys_pages, &page_count, page_count);
+
+    /* Allocate GPU VA range */
+    uint64_t gpu_va = sweet_gpu_vm_alloc_va(ctx, buffer->getLength());
+    if (gpu_va == 0) {
+        IOFree(phys_pages, page_count * sizeof(vm_offset_t));
+        return kIOReturnNoMemory;
+    }
+
+    int error = sweet_gpu_vm_map(ctx, gpu_va, phys_pages, page_count, VM_PROT_READ | VM_PROT_WRITE);
+    IOFree(phys_pages, page_count * sizeof(vm_offset_t));
+
+    if (error) {
+        sweet_gpu_vm_free_va(ctx, gpu_va, buffer->getLength());
+        return kIOReturnError;
+    }
+
+    *gpu_va_out = gpu_va;
+    *size_out = buffer->getLength();
+    return kIOReturnSuccess;
+}
+
+/*
+ * 0406: Unmap buffer from GPU VA
+ */
+void
+SapphireGpu::gpuUnmapBuffer(uint64_t gpu_va, uint32_t size)
+{
+    if (!fVmEnabled) {
+        return;
+    }
+
+    task_t task = current_task();
+    struct sweet_gpu_vm_context *ctx = sweet_gpu_vm_context_find(task);
+    if (!ctx) {
+        return;
+    }
+
+    uint32_t page_count = (size + SWEET_GPU_PAGE_SIZE - 1) / SWEET_GPU_PAGE_SIZE;
+    sweet_gpu_vm_unmap(ctx, gpu_va, page_count);
+    sweet_gpu_vm_free_va(ctx, gpu_va, size);
+}
+
+/*
+ * 0406: Map IOSurface for scanout/texture
+ */
+IOReturn
+SapphireGpu::gpuMapSurface(void *surface, uint64_t *gpu_va_out)
+{
+    if (!fVmEnabled) {
+        *gpu_va_out = 0xE2000000;  // Low DDR pool
+        return kIOReturnSuccess;
+    }
+
+    task_t task = current_task();
+    struct sweet_gpu_vm_context *ctx = sweet_gpu_vm_context_find(task);
+    if (!ctx) {
+        ctx = sweet_gpu_vm_context_create(task);
+    }
+
+    return sweet_gpu_vm_map_surface(ctx, surface, gpu_va_out);
+}
+
+/* 0317: GPU recovery */
+void
+SapphireGpu::gpu_recover(void)
+{
+    if (fVmEnabled && fVmLock) {
+        IOLockLock(fVmLock);
+        /* Re-initialize MMU */
+        gwr(REG_MMU_CB_ASID, fCurrentAsid);
+        gwr(REG_MMU_CB_TTBR0, fCurrentTtbr);
+        gwr(REG_MMU_CB_TTBR1, fCurrentTtbr);
+
+        uint64_t tcr = TCR_T0SZ(SWEET_GPU_VA_BITS) | TCR_TG0_4K |
+                       TCR_SH0_INNER | TCR_ORGN0_WB | TCR_IRGN0_WB |
+                       TCR_EPD0 | TCR_EPD1;
+        gwr(REG_MMU_CB_TCR, tcr);
+        gwr(REG_MMU_CB_SCTLR, 1);  // Enable MMU
+        gmb();
+        IOLockUnlock(fVmLock);
+    }
+
+    /* ... existing recovery code ... */
+}
