+++ b/iokit/Kernel/arm/SapphireGpu.cpp
@@ -1,3 +1,5 @@
+#include <bsd/dev/sweet_gpu_vm.h>
+#include <mach/task.h>
 /*
  * Adreno 610 driver for SM6225 (Xiaomi Redmi Note 13 4G / SWEET board)
@@ -50,6 +52,12 @@
 #define SWEET_GPU_REG_GPU_AO_BASE         0x05e00000
 #define SWEET_GPU_REG_GPU_BASE            0x05e80000

+/* 0406: GPU MMU registers */
+#define REG_MMU_CB_BASE                   0x05000
+#define REG_MMU_CB_ASID                   0x0000
+#define REG_MMU_CB_TTBR0                  0x0008
+#define REG_MMU_CB_TTBR1                  0x0010
+#define REG_MMU_CB_TCR                    0x0018
+#define REG_MMU_CB_CONTEXTIDR             0x0020
+#define REG_MMU_CB_SCTLR                  0x0028
+#define REG_MMU_CB_ACTLR                  0x0030
+
+/* TCR flags for 48-bit VA, 4KB pages, 2-level */
+#define TCR_T0SZ(x)                       ((64 - (x)) << 0)
+#define TCR_TG0_4K                        (0ull << 14)
+#define TCR_SH0_INNER                     (3ull << 28)
+#define TCR_ORGN0_WB                      (1ull << 10)
+#define TCR_IRGN0_WB                      (1ull << 8)
+#define TCR_EPD0                          (1ull << 7)
+#define TCR_EPD1                          (1ull << 23)
+
 /* ---- GPU registers ---- */
 #define REG_GPU_CX_GMU_GX_RESET           0x0000
 #define REG_GPU_CX_GMU_GX_BOOT            0x0004
@@ -260,6 +268,12 @@ class SapphireGpu : public IOService {
 	IOInterruptEventSource *fIrqSource;
 	IOSemaphore   *fReapSemaphore;
 	bool           fIrqEnabled;
 	bool           fServiceEnabled;
+	bool           fVmEnabled;              /* 0406: sweetgpu_vm=1 */
+	int            fCurrentAsid;            /* 0406: active ASID */
+	uint64_t       fCurrentTtbr;            /* 0406: active TTBR */
+	IOLock        *fVmLock;                 /* 0406: VM context switch lock */
+	struct sweet_gpu_vm_context *fKernelVmCtx;  /* 0406: kernel VM context */
+
 	static void submit_timer_fired(OSObject *owner, IOTimerEventSource *sender);
 	void submitIt();
@@ -380,6 +394,20 @@ SapphireGpu::start(IOService *provider)
 	    PE_parse_boot_argn("gpu_service", &fServiceEnabled, sizeof(fServiceEnabled));
 	}

+	/* 0406: Per-process GPU VM */
+	{
+		PE_parse_boot_argn("sweetgpu_vm", &fVmEnabled, sizeof(fVmEnabled));
+		if (fVmEnabled) {
+			fVmLock = IOLockAlloc();
+			fCurrentAsid = SWEET_GPU_KERNEL_ASID;
+			fKernelVmCtx = sweet_gpu_vm_context_create(kernel_task);
+			if (fKernelVmCtx) {
+				fCurrentTtbr = sweet_gpu_vm_get_ttbr(fKernelVmCtx);
+				LOG("gpu: VM enabled, kernel ASID=%d TTBR=0x%llx", fCurrentAsid, fCurrentTtbr);
+			}
+		}
+	}
+
 	/* 0317: GPU recovery */
