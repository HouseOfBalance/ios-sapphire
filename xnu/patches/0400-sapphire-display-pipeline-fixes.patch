+/*
+ * 0201: the vsync timer re-armed 16667 us after it had run (and after the frame it presented):
+ * every period was that much longer -- 57 Hz measured against the panel's frame counter. Now the
+ * ticks sit on an absolute 60.000 Hz grid; after a stall longer than a period the grid restarts.
+ */
+void
+AppleCLCD::armVsync(IOTimerEventSource *t)
+{
+	uint64_t period, now = mach_absolute_time();
+	nanoseconds_to_absolutetime(16666667ull, &period);
+	if (fNextVsync == 0 || now > fNextVsync + period) {
+		fNextVsync = now;
+	}
+	fNextVsync += period;
+	t->wakeAtTime(fNextVsync);
+}
+
+/*
+ * 0400: Cache coherency helper - clean cache lines to point of coherency after CPU write.
+ * Must be called after blitting to panel memory (write-combined or WB) before MDP scans it.
+ */
+static inline void
+sweet_dcache_clean(vm_offset_t addr, unsigned length)
+{
+	uint64_t ctr;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	uintptr_t line = 4UL << ((ctr >> 16) & 0xf);
+	for (vm_offset_t a = addr; a < addr + length; a += line) {
+		__asm__ volatile("dc cvac, %0" : : "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * 0400: Cache coherency helper - invalidate cache lines before GPU/DMA reads.
+ * Must be called before GPU reads from surface memory that CPU may have written.
+ */
+static inline void
+sweet_dcache_invalidate(vm_offset_t addr, unsigned length)
+{
+	uint64_t ctr;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	uintptr_t line = 4UL << ((ctr >> 16) & 0xf);
+	for (vm_offset_t a = addr; a < addr + length; a += line) {
+		__asm__ volatile("dc civac, %0" : : "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
