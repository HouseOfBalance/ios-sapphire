diff --git a/metal/shader_pipeline.h b/metal/shader_pipeline.h
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/metal/shader_pipeline.h
@@ -0,0 +1,111 @@
+/*
+ * Shader pipeline: AIR → NIR → IR3 → Adreno 610 binary
+ * For HakiosMetal driver on SM6225/sapphire
+ */
+#ifndef _SHADER_PIPELINE_H
+#define _SHADER_PIPELINE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* AIR metadata from Metal framework */
+struct air_metadata {
+    uint32_t version;
+    uint32_t function_count;
+    uint32_t *function_offsets;
+    uint8_t *data;
+    size_t size;
+};
+
+/* NIR shader representation */
+struct nir_shader {
+    uint32_t stage;              // vertex, fragment, compute, etc.
+    uint32_t num_inputs;
+    uint32_t num_outputs;
+    uint32_t num_uniforms;
+    uint32_t num_textures;
+    uint32_t num_samplers;
+    uint32_t num_ubos;
+    uint32_t num_ssbos;
+    uint32_t local_size[3];      // for compute
+    uint32_t workgroup_size[3];
+    void *nir;                   // opaque NIR pointer
+};
+
+/* IR3 shader representation */
+struct ir3_shader {
+    uint32_t stage;
+    uint32_t *instructions;
+    uint32_t instruction_count;
+    uint32_t *const_regs;
+    uint32_t const_reg_count;
+    uint32_t *sampler_states;
+    uint32_t sampler_count;
+    uint64_t *texture_descriptors;
+    uint32_t texture_count;
+    uint32_t registers_used;
+    uint32_t max_scalar_regs;
+    uint32_t max_vector_regs;
+};
+
+/* Final compiled binary */
+struct ir3_binary {
+    uint32_t *instructions;
+    uint32_t instruction_count;
+    uint32_t *symbol_table;
+    uint32_t symbol_count;
+    uint32_t registers_used;
+    uint64_t entry_point;
+};
+
+/* Pipeline context */
+struct shader_pipeline {
+    void *nir_context;
+    void *ir3_context;
+    void *compiler_context;
+
+    /* Options */
+    bool optimize;
+    bool debug;
+    uint32_t target_gpu;  // 610 for Adreno 610
+};
+
+/* Initialize pipeline */
+struct shader_pipeline *shader_pipeline_create(uint32_t target_gpu);
+void shader_pipeline_destroy(struct shader_pipeline *pipe);
+
+/* AIR → NIR */
+int air_to_nir(struct shader_pipeline *pipe, const struct air_metadata *air, struct nir_shader **nir_out);
+
+/* NIR → IR3 */
+int nir_to_ir3(struct shader_pipeline *pipe, const struct nir_shader *nir, struct ir3_shader **ir3_out);
+
+/* IR3 → Binary */
+int ir3_compile(struct shader_pipeline *pipe, const struct ir3_shader *ir3, struct ir3_binary **bin_out);
+
+/* Full pipeline */
+int shader_pipeline_compile(struct shader_pipeline *pipe, const struct air_metadata *air, struct ir3_binary **bin_out);
+
+/* Reflection info for Metal API */
+struct shader_reflection {
+    uint32_t num_attributes;
+    struct attribute_info {
+        char name[64];
+        uint32_t location;
+        uint32_t format;
+        uint32_t buffer_index;
+        uint32_t offset;
+    } *attributes;
+    uint32_t num_resources;
+    struct resource_info {
+        char name[64];
+        uint32_t type;  // buffer, texture, sampler
+        uint32_t binding;
+        uint32_t set;
+        uint32_t count;
+    } *resources;
+};
+
+int shader_pipeline_reflect(struct shader_pipeline *pipe, const struct nir_shader *nir, struct shader_reflection **refl_out);
+
+#endif /* _SHADER_PIPELINE_H */
diff --git a/metal/air_to_nir.c b/metal/air_to_nir.c
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/metal/air_to_nir.c
@@ -0,0 +1,201 @@
+/*
+ * AIR → NIR translation for Metal shaders
+ * Based on Mesa's spirv_to_nir and Apple's AIR specification
+ */
+#include "shader_pipeline.h"
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+/* AIR instruction opcodes (subset) */
+enum air_opcode {
+    AIR_OP_MOV = 0x01,
+    AIR_OP_ADD = 0x02,
+    AIR_OP_MUL = 0x03,
+    AIR_OP_FMA = 0x04,
+    AIR_OP_DP4 = 0x05,
+    AIR_OP_TEX = 0x10,
+    AIR_OP_SAMPLE = 0x11,
+    AIR_OP_LOAD = 0x20,
+    AIR_OP_STORE = 0x21,
+    AIR_OP_ATOMIC = 0x22,
+    AIR_OP_BARRIER = 0x30,
+    AIR_OP_DISCARD = 0x31,
+    AIR_OP_BRANCH = 0x40,
+    AIR_OP_CALL = 0x41,
+    AIR_OP_RETURN = 0x42,
+};
+
+/* NIR builder wrapper */
+struct air_nir_builder {
+    void *nir_builder;
+    struct nir_shader *shader;
+    void *function;
+    void **ssa_defs;      // AIR SSA -> NIR SSA mapping
+    uint32_t ssa_count;
+    uint32_t *block_stack;
+    uint32_t block_depth;
+};
+
+static struct nir_shader *
+air_create_nir_shader(enum air_opcode stage)
+{
+    struct nir_shader *nir = calloc(1, sizeof(struct nir_shader));
+    nir->stage = stage;
+    nir->nir = nir_shader_create(NULL, MESA_SHADER_VERTEX);  // placeholder
+    return nir;
+}
+
+static void
+air_translate_instruction(struct air_nir_builder *b, uint32_t opcode, uint32_t *args, uint32_t arg_count)
+{
+    void *nir_builder = b->nir_builder;
+
+    switch (opcode) {
+    case AIR_OP_MOV:
+        // MOV dst, src
+        nir_build_alu(nir_builder, nir_op_mov, b->ssa_defs[args[1]], NULL, NULL, NULL);
+        b->ssa_defs[args[0]] = nir_builder->last_dest;
+        break;
+
+    case AIR_OP_ADD:
+        // ADD dst, src1, src2
+        nir_build_alu(nir_builder, nir_op_fadd, b->ssa_defs[args[1]], b->ssa_defs[args[2]], NULL, NULL);
+        b->ssa_defs[args[0]] = nir_builder->last_dest;
+        break;
+
+    case AIR_OP_MUL:
+        nir_build_alu(nir_builder, nir_op_fmul, b->ssa_defs[args[1]], b->ssa_defs[args[2]], NULL, NULL);
+        b->ssa_defs[args[0]] = nir_builder->last_dest;
+        break;
+
+    case AIR_OP_FMA:
+        nir_build_alu(nir_builder, nir_op_ffma, b->ssa_defs[args[1]], b->ssa_defs[args[2]], b->ssa_defs[args[3]], NULL);
+        b->ssa_defs[args[0]] = nir_builder->last_dest;
+        break;
+
+    case AIR_OP_DP4:
+        nir_build_alu(nir_builder, nir_op_fdot4, b->ssa_defs[args[1]], b->ssa_defs[args[2]], NULL, NULL);
+        b->ssa_defs[args[0]] = nir_builder->last_dest;
+        break;
+
+    case AIR_OP_TEX:
+    case AIR_OP_SAMPLE:
+        // Texture sampling - create tex intrinsic
+        {
+            nir_tex_instr *tex = nir_tex_instr_create(nir_builder->shader, 4);
+            tex->op = nir_texop_tex;
+            tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+            tex->coord_components = 2;
+            tex->src[0].src_type = nir_tex_src_coord;
+            tex->src[0].src = nir_src_for_ssa(b->ssa_defs[args[2]]);  // coordinates
+            tex->src[1].src_type = nir_tex_src_texture_deref;
+            tex->src[1].src = nir_src_for_ssa(b->ssa_defs[args[3]]);  // texture
+            tex->src[2].src_type = nir_tex_src_sampler_deref;
+            tex->src[2].src = nir_src_for_ssa(b->ssa_defs[args[4]]);  // sampler
+            nir_builder_add_instr(nir_builder, &tex->instr);
+            b->ssa_defs[args[0]] = &tex->dest.ssa;
+        }
+        break;
+
+    case AIR_OP_LOAD:
+        // Buffer/UBO load
+        {
+            nir_intrinsic_instr *load = nir_intrinsic_instr_create(nir_builder->shader, nir_intrinsic_load_ubo);
+            load->src[0] = nir_src_for_ssa(b->ssa_defs[args[1]]);  // buffer index
+            load->src[1] = nir_src_for_ssa(b->ssa_defs[args[2]]);  // offset
+            load->num_components = 4;
+            nir_builder_add_instr(nir_builder, &load->instr);
+            b->ssa_defs[args[0]] = &load->dest.ssa;
+        }
+        break;
+
+    case AIR_OP_STORE:
+        // Buffer/SSBO store
+        {
+            nir_intrinsic_instr *store = nir_intrinsic_instr_create(nir_builder->shader, nir_intrinsic_store_ssbo);
+            store->src[0] = nir_src_for_ssa(b->ssa_defs[args[1]]);  // value
+            store->src[1] = nir_src_for_ssa(b->ssa_defs[args[2]]);  // buffer index
+            store->src[2] = nir_src_for_ssa(b->ssa_defs[args[3]]);  // offset
+            nir_builder_add_instr(nir_builder, &store->instr);
+        }
+        break;
+
+    case AIR_OP_DISCARD:
+        nir_build_intrinsic(nir_builder, nir_intrinsic_discard, 0);
+        break;
+
+    case AIR_OP_BRANCH:
+        // Conditional branch
+        {
+            void *cond = b->ssa_defs[args[0]];
+            void *then_block = b->ssa_defs[args[1]];
+            void *else_block = b->ssa_defs[args[2]];
+            nir_build_if(nir_builder, cond);
+            // then_block
+            nir_push_else(nir_builder);
+            // else_block
+            nir_pop_if(nir_builder);
+        }
+        break;
+
+    default:
+        fprintf(stderr, "air_to_nir: unhandled opcode 0x%02x\n", opcode);
+        break;
+    }
+}
+
+int
+air_to_nir(struct shader_pipeline *pipe, const struct air_metadata *air, struct nir_shader **nir_out)
+{
+    // Parse AIR metadata and translate each function
+    for (uint32_t i = 0; i < air->function_count; i++) {
+        uint32_t offset = air->function_offsets[i];
+        uint8_t *func_data = air->data + offset;
+
+        // Read function header
+        uint32_t stage = *(uint32_t *)(func_data);
+        uint32_t ssa_count = *(uint32_t *)(func_data + 4);
+        uint32_t instr_count = *(uint32_t *)(func_data + 8);
+
+        struct nir_shader *nir = air_create_nir_shader(stage);
+        struct air_nir_builder b = {0};
+        b.shader = nir;
+        b.nir_builder = nir_builder_create(nir->nir);
+        b.ssa_defs = calloc(ssa_count, sizeof(void *));
+        b.ssa_count = ssa_count;
+
+        // Create input/output variables
+        // ... create nir_variables for function parameters ...
+
+        // Translate instructions
+        uint8_t *instr_ptr = func_data + 16;
+        for (uint32_t j = 0; j < instr_count; j++) {
+            uint32_t opcode = *(uint32_t *)instr_ptr;
+            uint32_t arg_count = *(uint32_t *)(instr_ptr + 4);
+            uint32_t *args = (uint32_t *)(instr_ptr + 8);
+
+            air_translate_instruction(&b, opcode, args, arg_count);
+
+            instr_ptr += 8 + arg_count * 4;
+        }
+
+        // Run NIR optimization passes
+        if (pipe->optimize) {
+            NIR_PASS_V(nir->nir, nir_opt_algebraic);
+            NIR_PASS_V(nir->nir, nir_opt_constant_folding);
+            NIR_PASS_V(nir->nir, nir_opt_dead_cf);
+            NIR_PASS_V(nir->nir, nir_opt_cse);
+            NIR_PASS_V(nir->nir, nir_opt_loop);
+            NIR_PASS_V(nir->nir, nir_lower_io_to_scalar, nir_var_function_temp, NULL);
+        }
+
+        // Lower to NIR generic
+        NIR_PASS_V(nir->nir, nir_lower_io, nir_var_shader_in | nir_var_shader_out, type_size, 0);
+        NIR_PASS_V(nir->nir, nir_lower_explicit_io, nir_var_mem_ubo | nir_var_mem_ssbo, nir_address_format_32bit_index_offset);
+
+        *nir_out = nir;
+    }
+
+    return 0;
+}
diff --git a/metal/nir_to_ir3.c b/metal/nir_to_ir3.c
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/metal/nir_to_ir3.c
@@ -0,0 +1,241 @@
+/*
+ * NIR → IR3 translation for Adreno 610
+ * Based on freedreno's nir_to_ir3.c
+ */
+#include "shader_pipeline.h"
+#include <stdlib.h>
+#include <string.h>
+
+/* IR3 instruction format (scalar) */
+#define IR3_INSTR_BITS(opc, cat, type)  (((opc) & 0x7f) | ((cat) << 7) | ((type) << 10))
+#define IR3_INSTR_CAT1                  0x0
+#define IR3_INSTR_CAT2                  0x1
+#define IR3_INSTR_CAT3                  0x2
+#define IR3_INSTR_CAT4                  0x3
+#define IR3_INSTR_CAT5                  0x4
+#define IR3_INSTR_CAT6                  0x5
+#define IR3_INSTR_CAT7                  0x6
+
+/* IR3 opcodes (subset) */
+enum ir3_opcode {
+    IR3_OPC_MOV = 0x00,
+    IR3_OPC_ADD_F = 0x01,
+    IR3_OPC_MUL_F = 0x02,
+    IR3_OPC_FMA_F = 0x03,
+    IR3_OPC_DP4_F = 0x04,
+    IR3_OPC_TEX = 0x10,
+    IR3_OPC_SAMPLE = 0x11,
+    IR3_OPC_LOAD = 0x20,
+    IR3_OPC_STORE = 0x21,
+    IR3_OPC_JUMP = 0x30,
+    IR3_OPC_BR = 0x31,
+    IR3_OPC_NOP = 0x3f,
+};
+
+/* IR3 register file */
+enum ir3_reg_file {
+    IR3_REG_SSA = 0,
+    IR3_REG_CONST = 1,
+    IR3_REG_IMMED = 2,
+    IR3_REG_ADDR = 3,
+};
+
+struct ir3_builder {
+    struct ir3_shader *shader;
+    uint32_t *instructions;
+    uint32_t instr_count;
+    uint32_t instr_capacity;
+    uint32_t *ssa_to_reg;
+    uint32_t ssa_count;
+    uint32_t next_reg;
+    uint32_t *block_stack;
+    uint32_t block_depth;
+};
+
+static struct ir3_shader *
+ir3_create_shader(enum ir3_stage stage)
+{
+    struct ir3_shader *sh = calloc(1, sizeof(struct ir3_shader));
+    sh->stage = stage;
+    sh->instructions = calloc(1024, sizeof(uint32_t));
+    sh->instruction_count = 0;
+    sh->const_regs = calloc(256, sizeof(uint32_t));
+    sh->const_reg_count = 0;
+    return sh;
+}
+
+static uint32_t
+ir3_emit(struct ir3_builder *b, uint32_t instr)
+{
+    if (b->instr_count >= b->instr_capacity) {
+        b->instr_capacity *= 2;
+        b->instructions = realloc(b->instructions, b->instr_capacity * sizeof(uint32_t));
+    }
+    b->instructions[b->instr_count++] = instr;
+    return b->instr_count - 1;
+}
+
+static uint32_t
+ir3_get_reg(struct ir3_builder *b, uint32_t ssa)
+{
+    if (b->ssa_to_reg[ssa] == 0) {
+        b->ssa_to_reg[ssa] = b->next_reg++;
+    }
+    return b->ssa_to_reg[ssa];
+}
+
+static void
+ir3_translate_alu(struct ir3_builder *b, nir_alu_instr *alu)
+{
+    nir_op op = alu->op;
+    uint32_t dst = ir3_get_reg(b, alu->dest.dest.ssa.index);
+
+    switch (op) {
+    case nir_op_mov:
+        {
+            uint32_t src = ir3_get_reg(b, alu->src[0].src.ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_MOV, IR3_INSTR_CAT1, 0) |
+                            (dst << 16) | (src << 21);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_op_fadd:
+        {
+            uint32_t src0 = ir3_get_reg(b, alu->src[0].src.ssa->index);
+            uint32_t src1 = ir3_get_reg(b, alu->src[1].src.ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_ADD_F, IR3_INSTR_CAT3, 0) |
+                            (dst << 16) | (src0 << 21) | (src1 << 26);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_op_fmul:
+        {
+            uint32_t src0 = ir3_get_reg(b, alu->src[0].src.ssa->index);
+            uint32_t src1 = ir3_get_reg(b, alu->src[1].src.ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_MUL_F, IR3_INSTR_CAT3, 0) |
+                            (dst << 16) | (src0 << 21) | (src1 << 26);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_op_ffma:
+        {
+            uint32_t src0 = ir3_get_reg(b, alu->src[0].src.ssa->index);
+            uint32_t src1 = ir3_get_reg(b, alu->src[1].src.ssa->index);
+            uint32_t src2 = ir3_get_reg(b, alu->src[2].src.ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_FMA_F, IR3_INSTR_CAT3, 0) |
+                            (dst << 16) | (src0 << 21) | (src1 << 26) | (src2 << 31);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_op_fdot4:
+        {
+            uint32_t src0 = ir3_get_reg(b, alu->src[0].src.ssa->index);
+            uint32_t src1 = ir3_get_reg(b, alu->src[1].src.ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_DP4_F, IR3_INSTR_CAT4, 0) |
+                            (dst << 16) | (src0 << 21) | (src1 << 26);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    default:
+        // Emit MOV for unsupported
+        uint32_t src = ir3_get_reg(b, alu->src[0].src.ssa->index);
+        uint32_t instr = IR3_INSTR_BITS(IR3_OPC_MOV, IR3_INSTR_CAT1, 0) |
+                        (dst << 16) | (src << 21);
+        ir3_emit(b, instr);
+        break;
+    }
+}
+
+static void
+ir3_translate_tex(struct ir3_builder *b, nir_tex_instr *tex)
+{
+    uint32_t dst = ir3_get_reg(b, tex->dest.ssa.index);
+    uint32_t coord = ir3_get_reg(b, tex->src[0].src.ssa->index);
+    uint32_t texture = ir3_get_reg(b, tex->src[1].src.ssa->index);
+    uint32_t sampler = ir3_get_reg(b, tex->src[2].src.ssa->index);
+
+    uint32_t instr = IR3_INSTR_BITS(IR3_OPC_SAMPLE, IR3_INSTR_CAT5, 0) |
+                    (dst << 16) | (coord << 21) | (texture << 26) | (sampler << 31);
+    ir3_emit(b, instr);
+}
+
+static void
+ir3_translate_intrinsic(struct ir3_builder *b, nir_intrinsic_instr *intr)
+{
+    switch (intr->intrinsic) {
+    case nir_intrinsic_load_ubo:
+    case nir_intrinsic_load_ssbo:
+        {
+            uint32_t dst = ir3_get_reg(b, intr->dest.ssa.index);
+            uint32_t buffer = ir3_get_reg(b, intr->src[0].ssa->index);
+            uint32_t offset = ir3_get_reg(b, intr->src[1].ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_LOAD, IR3_INSTR_CAT6, 0) |
+                            (dst << 16) | (buffer << 21) | (offset << 26);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_intrinsic_store_ssbo:
+        {
+            uint32_t value = ir3_get_reg(b, intr->src[0].ssa->index);
+            uint32_t buffer = ir3_get_reg(b, intr->src[1].ssa->index);
+            uint32_t offset = ir3_get_reg(b, intr->src[2].ssa->index);
+            uint32_t instr = IR3_INSTR_BITS(IR3_OPC_STORE, IR3_INSTR_CAT6, 0) |
+                            (value << 16) | (buffer << 21) | (offset << 26);
+            ir3_emit(b, instr);
+        }
+        break;
+
+    case nir_intrinsic_discard:
+        ir3_emit(b, IR3_INSTR_BITS(IR3_OPC_NOP, IR3_INSTR_CAT1, 0));  // placeholder
+        break;
+    }
+}
+
+int
+nir_to_ir3(struct shader_pipeline *pipe, const struct nir_shader *nir, struct ir3_shader **ir3_out)
+{
+    struct ir3_shader *ir3 = ir3_create_shader(nir->stage);
+    struct ir3_builder b = {0};
+    b.shader = ir3;
+    b.instructions = ir3->instructions;
+    b.instr_capacity = 1024;
+    b.ssa_to_reg = calloc(nir->nir->num_ssa_defs, sizeof(uint32_t));
+    b.ssa_count = nir->nir->num_ssa_defs;
+    b.next_reg = 1;
+
+    // Iterate NIR blocks and instructions
+    nir_foreach_function_impl(impl, nir->nir) {
+        nir_foreach_block(block, impl) {
+            nir_foreach_instr(instr, block) {
+                switch (instr->type) {
+                case nir_instr_type_alu:
+                    ir3_translate_alu(&b, nir_instr_as_alu(instr));
+                    break;
+                case nir_instr_type_tex:
+                    ir3_translate_tex(&b, nir_instr_as_tex(instr));
+                    break;
+                case nir_instr_type_intrinsic:
+                    ir3_translate_intrinsic(&b, nir_instr_as_intrinsic(instr));
+                    break;
+                case nir_instr_type_jump:
+                    // Handle control flow
+                    break;
+                }
+            }
+        }
+    }
+
+    ir3->instruction_count = b.instr_count;
+    ir3->registers_used = b.next_reg;
+    ir3->max_scalar_regs = b.next_reg;
+    ir3->max_vector_regs = b.next_reg / 4;
+
+    *ir3_out = ir3;
+    return 0;
+}
diff --git a/metal/ir3_compiler.c b/metal/ir3_compiler.c
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/metal/ir3_compiler.c
@@ -0,0 +1,102 @@
+/*
+ * IR3 → Adreno 610 binary compilation
+ * Final assembly and binary emission
+ */
+#include "shader_pipeline.h"
+#include <stdlib.h>
+#include <string.h>
+
+/* Adreno 610 instruction encoding */
+struct adreno_instr {
+    uint32_t opc:7;
+    uint32_t cat:3;
+    uint32_t type:3;
+    uint32_t dst:6;
+    uint32_t src0:6;
+    uint32_t src1:6;
+    uint32_t src2:6;
+    uint32_t flags:2;
+};
+
+static uint32_t
+encode_cat1(uint32_t opc, uint32_t dst, uint32_t src0)
+{
+    return (opc & 0x7f) | ((dst & 0x3f) << 16) | ((src0 & 0x3f) << 22);
+}
+
+static uint32_t
+encode_cat3(uint32_t opc, uint32_t dst, uint32_t src0, uint32_t src1)
+{
+    return (opc & 0x7f) | (1 << 7) | ((dst & 0x3f) << 16) | ((src0 & 0x3f) << 22) | ((src1 & 0x3f) << 28);
+}
+
+static uint32_t
+encode_cat4(uint32_t opc, uint32_t dst, uint32_t src0, uint32_t src1, uint32_t src2)
+{
+    return (opc & 0x7f) | (2 << 7) | ((dst & 0x3f) << 16) | ((src0 & 0x3f) << 22) | ((src1 & 0x3f) << 28) | ((src2 & 0x3f) << 34);
+}
+
+static uint32_t
+encode_cat5(uint32_t opc, uint32_t dst, uint32_t src0, uint32_t src1, uint32_t src2)
+{
+    return (opc & 0x7f) | (3 << 7) | ((dst & 0x3f) << 16) | ((src0 & 0x3f) << 22) | ((src1 & 0x3f) << 28) | ((src2 & 0x3f) << 34);
+}
+
+static uint32_t
+encode_cat6(uint32_t opc, uint32_t dst, uint32_t src0, uint32_t src1)
+{
+    return (opc & 0x7f) | (4 << 7) | ((dst & 0x3f) << 16) | ((src0 & 0x3f) << 22) | ((src1 & 0x3f) << 28);
+}
+
+int
+ir3_compile(struct shader_pipeline *pipe, const struct ir3_shader *ir3, struct ir3_binary **bin_out)
+{
+    struct ir3_binary *bin = calloc(1, sizeof(struct ir3_binary));
+    bin->instructions = calloc(ir3->instruction_count, sizeof(uint32_t));
+    bin->instruction_count = 0;
+    bin->registers_used = ir3->registers_used;
+
+    for (uint32_t i = 0; i < ir3->instruction_count; i++) {
+        uint32_t instr = ir3->instructions[i];
+        uint32_t opc = instr & 0x7f;
+        uint32_t cat = (instr >> 7) & 0x7;
+        uint32_t dst = (instr >> 16) & 0x3f;
+        uint32_t src0 = (instr >> 22) & 0x3f;
+        uint32_t src1 = (instr >> 28) & 0x3f;
+        uint32_t src2 = (instr >> 34) & 0x3f;
+
+        uint32_t encoded = 0;
+        switch (cat) {
+        case 0:
+            encoded = encode_cat1(opc, dst, src0);
+            break;
+        case 1:
+            encoded = encode_cat1(opc, dst, src0);  // Cat2 similar
+            break;
+        case 2:
+            encoded = encode_cat3(opc, dst, src0, src1);
+            break;
+        case 3:
+            encoded = encode_cat4(opc, dst, src0, src1, src2);
+            break;
+        case 4:
+            encoded = encode_cat5(opc, dst, src0, src1, src2);
+            break;
+        case 5:
+            encoded = encode_cat6(opc, dst, src0, src1);
+            break;
+        }
+
+        bin->instructions[bin->instruction_count++] = encoded;
+    }
+
+    /* Create symbol table for Metal reflection */
+    bin->symbol_table = calloc(64, sizeof(uint32_t));
+    bin->symbol_count = 0;
+
+    /* Entry point is first instruction */
+    bin->entry_point = 0;
+
+    *bin_out = bin;
+    return 0;
+}
diff --git a/metal/HakiosMetalCompiler.cpp b/metal/HakiosMetalCompiler.cpp
new file mode 100644
index 0000000..b2c3d4e
--- /dev/null
+++ b/metal/HakiosMetalCompiler.cpp
@@ -0,0 +1,78 @@
+/*
+ * HakiosMetalCompiler - Metal shader compiler entry point
+ * Called from HakiosMetalLibrary when creating functions
+ */
+#include "HakiosMetalCompiler.h"
+#include "shader_pipeline.h"
+#include <Metal/Metal.h>
+
+OSDefineMetaClassAndStructors(HakiosMetalCompiler, IOService);
+
+id
+HakiosMetalCompiler::initWithDevice(id<MTLDevice> device)
+{
+    self = [super init];
+    if (self) {
+        _device = device;
+        _pipeline = shader_pipeline_create(610);  // Adreno 610
+        _pipeline->optimize = YES;
+        _pipeline->debug = NO;
+    }
+    return self;
+}
+
+void
+HakiosMetalCompiler::free()
+{
+    if (_pipeline) {
+        shader_pipeline_destroy(_pipeline);
+    }
+    [super free];
+}
+
+id<MTLFunction>
+HakiosMetalCompiler::newFunctionWithName(NSString *name, MTLFunctionOptions options, NSError **error)
+{
+    // Get AIR metadata from Metal framework
+    struct air_metadata air = {0};
+    // In real implementation, extract from Metal's internal representation
+
+    struct ir3_binary *binary = NULL;
+    int result = shader_pipeline_compile(_pipeline, &air, &binary);
+    if (result != 0) {
+        if (error) *error = [NSError errorWithDomain:@"HakiosMetal" code:result userInfo:nil];
+        return nil;
+    }
+
+    // Create MTLFunction from binary
+    id<MTLFunction> function = [[HakiosMetalFunction alloc] initWithDevice:_device binary:binary name:name];
+    return function;
+}
+
+id<MTLComputePipelineState>
+HakiosMetalCompiler::newComputePipelineStateWithFunction(id<MTLFunction> function, NSError **error)
+{
+    HakiosMetalFunction *func = (HakiosMetalFunction *)function;
+    id<MTLComputePipelineState> state = [[HakiosComputePipelineState alloc] initWithDevice:_device function:func];
+    return state;
+}
+
+id<MTLRenderPipelineState>
+HakiosMetalCompiler::newRenderPipelineStateWithDescriptor(const MTLRenderPipelineDescriptor *descriptor, NSError **error)
+{
+    // Compile vertex and fragment functions
+    HakiosMetalFunction *vs = (HakiosMetalFunction *)descriptor.vertexFunction;
+    HakiosMetalFunction *fs = (HakiosMetalFunction *)descriptor.fragmentFunction;
+
+    id<MTLRenderPipelineState> state = [[HakiosRenderPipelineState alloc] initWithDevice:_device vertexFunction:vs fragmentFunction:fs descriptor:descriptor];
+    return state;
+}
+
+struct shader_reflection *
+HakiosMetalCompiler::reflectFunction(id<MTLFunction> function)
+{
+    HakiosMetalFunction *func = (HakiosMetalFunction *)function;
+    struct shader_reflection *refl = NULL;
+    shader_pipeline_reflect(_pipeline, func->nir_shader, &refl);
+    return refl;
+}
